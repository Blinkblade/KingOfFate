# ============================================================================
# KingOfFate — Test Fighter A : CPU AI（AI.zss）   [P3 · T10]
#
# ★★★ 两条必须记住的机制（P1 实验 E6 直接验证）★★★
#
#   1. AI **不走命令系统**。它不模拟按键、不看 .cmd、不看 command.zss，
#      而是直接 `changeState{value: N}`。
#      → 所以改 .cmd 不会影响 AI；反过来，AI 能做出的动作不受命令定义限制。
#        代价：AI 的招式分散度**完全靠自己写**，不会"自动学会"角色的新招。
#
#   2. **优先级 = 本文件的书写顺序**。同一个 tick 里，先出现的 changeState
#      先生效，没有权重、没有评分、没有回退。
#      → 一条写得太靠前、条件太宽的规则会**静默废掉它后面的一切**。
#        E6 就是活生生的例子：链首插一条 `if … { changeState{value: 210} }`，
#        AI 行为立刻从 7 种状态塌缩成单一招式，且对手全程未掉血。
#
# 因此：**顺序表就是这个 AI 的设计本身**，不是实现细节。
#
# P3 的范围（合同 §21）：第一次为一个独立角色配置 CPU AI。
# 要求：**能正确选择** Normal / 两个 Special / EX / Super / 投技，
#       条件彼此不冲突、不会被一条宽条件吞掉、Power 条件正确。
# 仍然**不是** Utility AI（无评分、无 planner、无学习 —— 那属 P9）。
#
# ---------------------------------------------------------------------------
# 本角色的顺序表（改顺序 = 改行为，必须重跑 Runtime 验证）：
#
#   ① 防御        对手正在攻击且在防御距离内 → 公共状态 120
#   ② 对空        对手在空中 + 中距离 + 冷却结束 → Special 2（1100 升龙踢）
#   ③ Super       Power ≥ 1000 + 中距离 + 冷却结束 + 概率 → 3000
#   ④ EX          Power ≥ 500  + 中距离 + 冷却结束 + 概率 → 1010
#   ⑤ Special 1   中距离 + 冷却结束（无 Power 要求的兜底必杀）→ 1000
#   ⑥ 普通技      近距离（< 45）→ 200 / 430 / 210（按概率分摊）
#   ⑦ 投技        贴身（< 12）+ 概率（带 aiLevelF，低难度更少用）
#   ⑧ 接近        中远距离 → 走路（公共状态 20）
#
# ---------------------------------------------------------------------------
# ★ 为什么 ③④⑤ 都有"概率闸门"（random）：三条规则的**距离波段相同**
#   （都是 45–130）。如果 ③ 只写 `power >= 1000`，那么只要气够，
#   ④⑤ 永远轮不到 —— 那就正好犯了 E6 的错（一条宽条件吞掉后面全部）。
#   加上 `random <= N` 之后，三条各自的触发概率独立，都能被观测到：
#     Power ≥ 1000 时 → ③ 约 25%，其余落到 ④（约 30%）与 ⑤（兜底）
#     Power 500–999  时 → ③ 不成立，④ 约 40%，其余 ⑤
#     Power < 500    时 → 只有 ⑤
#
# ★ 波段边界刻意不重叠：② 是 30–150 但要求"对手在空中"，
#   ⑥ 是 < 45 但要求"对手在地面"（$grounded）—— 避免两条同时成立。
#
# 依据：docs/ikemen_character_architecture.md §7
# 实测对照：game/chars/p1_kfm_zss_lab/AI.zss
# ============================================================================


# ============================================================================
# [StateDef -4] —— 全局状态
# 非战斗状态下的收尾：例如跑动状态在回合结束后要强制解除。
# ============================================================================
[StateDef -4]

if stateNo = 100 && roundState != 2 && aiLevelF {
    changeState{value: 0; ctrl: 1}
}


# ============================================================================
# [StateDef -1] —— AI 主循环（每 tick）
# ============================================================================
[StateDef -1]

# 只在"战斗中 + 由 AI 操作 + 不是待机/暂停"时决策。
# ignoreHitPause = 命中停顿期间也要继续思考。
ignoreHitPause if aiLevelF && roundState = 2 && !standby {

    # ------------------------------------------------------------------------
    # 关闭引擎的默认自动行为 —— 移动/跳跃必须由 AI 自己决定
    # ------------------------------------------------------------------------
    assertSpecial{flag: nojump; flag2: noairjump}   # 禁默认跳跃
    assertSpecial{flag: nowalk; flag2: nobrake}     # 禁默认走路

    # ------------------------------------------------------------------------
    # 派生量（每 tick 算一次，后面所有规则复用）
    # ------------------------------------------------------------------------
    let grounded = p2StateType = S || p2StateType = C;   # 对手在地面
    let p2air = p2StateType = A;                          # 对手在空中
    let closeR = p2BodyDist x < 45;                       # 近距离
    let midR = p2BodyDist x = [45, 130];                  # 中距离

    # var(1) = 特殊技冷却（tick）。见 .const 的变量台账。
    # 没有它，AI 会在冷却结束前每 tick 都试图出必杀技。
    if var(1) > 0 {
        var(1) := var(1) - 1;
    }

    # ========================================================================
    # ① 防御 —— 复用公共状态 120（GUARDSTART, stand）
    # 条件刻意收紧：只在"对手正在攻击且在防御距离内"时触发，
    # 否则它会吃掉后面所有进攻规则。
    # ========================================================================
    if ctrl && stateType != A && p2MoveType = A && inGuardDist {
        assertSpecial{flag: autoguard}
        changeState{value: 120}
    }

    # ========================================================================
    # ② 对空 —— Special 2「升龙踢」（State 1100）
    # 只在**对手真的在空中**时使用：这就是这招的设计用途，
    # 也是"AI 能区分两个 Special"的直接证据（对手在地面时它不会乱放）。
    # ========================================================================
    if ctrl && stateType = S && $p2air && var(1) = 0 && p2BodyDist x = [30, 150] {
        changeState{value: 1100}
        var(1) := 120;
    }

    # ========================================================================
    # ③ Super —— State 3000（Power ≥ 1000）
    # 概率闸门保证它不会吞掉 ④ ⑤（见文件头说明）。
    # ========================================================================
    if ctrl && stateType = S && $grounded && var(1) = 0 &&
        power >= 1000 && $midR && random <= 250 {
        changeState{value: 3000}
        var(1) := 200;
    }

    # ========================================================================
    # ④ EX —— State 1010（Power ≥ 500）
    # ========================================================================
    if ctrl && stateType = S && $grounded && var(1) = 0 &&
        power >= 500 && $midR && random <= 400 {
        changeState{value: 1010}
        var(1) := 160;
    }

    # ========================================================================
    # ⑤ Special 1 —— State 1000（无 Power 要求，兜底必杀）
    # ========================================================================
    if ctrl && stateType = S && $grounded && var(1) = 0 && $midR {
        changeState{value: 1000}
        var(1) := 120;
    }

    # ========================================================================
    # ⑥ 普通技 —— 近距离三选一（各自的概率闸门独立）
    # 三条都要求 $closeR（< 45）；⑥b 的窗口略窄（< 42），保证它不是
    # "被 ⑥a 完全吞掉"的死规则。
    # ========================================================================
    # ⑥a 站立轻拳 A（200）：最快，最先考虑
    if ctrl && stateType = S && $grounded && $closeR && random <= 400 {
        changeState{value: 200}
    }
    # ⑥b 蹲轻脚 B（430）：下段，逼对手换防
    if ctrl && stateType = S && $grounded && p2BodyDist x < 42 && random <= 300 {
        changeState{value: 430}
    }
    # ⑥c 站立重拳 C（210）：高伤害收尾
    if ctrl && stateType = S && $grounded && $closeR && random <= 150 {
        changeState{value: 210}
    }

    # ========================================================================
    # ⑦ 投技 —— 贴身时使用。
    # 故意排在 ⑥ 之后：贴身时优先普通技，投技只是偶尔穿插。
    # 概率带 aiLevelF，保证低难度 AI 确实更少用投技。
    # ========================================================================
    if ctrl && stateType = S && $grounded && p2MoveType != H &&
        p2BodyDist x < 12 && random <= (200 * (aiLevelF ** 2 / 48.0)) {
        changeState{value: 800}
    }

    # ========================================================================
    # ⑧ 接近 —— 走路（公共状态 20）
    # 必须排在攻击之后，否则 AI 会一直走路、永远不出招。
    # stateNo != 20：避免每 tick 重新进入 20 导致动画被不断重置。
    # ========================================================================
    if ctrl && stateType = S && stateNo != 20 && p2BodyDist x >= 45 {
        changeState{value: 20}
    }

}

# ============================================================================
# 顺序自查清单（每改一次顺序都要过一遍）
#
#   [ ] 有没有哪条规则的条件宽到会"吃掉"后面所有规则？
#       （P3 特别注意：③④⑤ 距离波段相同，靠 random 闸门 + Power 条件区分）
#   [ ] 移动类规则是否都排在攻击类规则之后？
#   [ ] 概率系数是否都带了 aiLevelF，以保证低难度确实更弱？
#   [ ] 新增的 changeState 目标状态是否真的存在（拼错状态号 = 静默无反应）？
#
# 验证方法：跑一局 AI vs AI，用 Ctrl+D 读状态号序列，
#           确认状态号是**多样**的，而不是塌缩成一两个。
#           工具见 tests/p1/README.md。
# ============================================================================
