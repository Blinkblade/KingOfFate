# ============================================================================
# 基础投技（T4） —— 起手：抓人
#
# 结构（照抄 KFM 的投技组织，见 kfm.zss:765）：
#   hitDef 的 attr 必须是 **S, NT**（Normal Throw）
#   priority 必须是 Miss 或 Dodge，且数值要低（1），否则会压过普通攻击
#   p1stateno / p2stateno 指定"抓到之后"双方各自进入的状态
#   guard.dist: 0 —— 贴身时不允许对手进入防御
#
# 触发条件在 command.zss §⑤：贴身 + 对手在地面 + 对手不在受击硬直。
# 抓不到时 moveContact = 0，EndState 直接回站立。
# ============================================================================
[StateDef 800;
type: S; movetype: A; physics: S;
juggle: 0; velset: 0, 0; ctrl: 0;
anim: 800;
poweradd: 10;
sprpriority: 2;]

if time = 0 {
    hitDef{
        attr: S, NT;            # Standing, Normal Throw
        hitflag: M-;            # 只影响"没在被打"的地面目标 —— 防止投技接进连段
        priority: 1, Miss;      # 投技优先级必须低，且必须是 Miss/Dodge
        sparkno: -1;            # 无火花
        p1sprpriority: 1;       # 投技时把自己画在对手前面
        p1facing: 1;
        p2facing: 1;            # 强制对手面向自己
        p1stateno: 810;         # 抓到 → 自己进 810
        p2stateno: 820;         # 抓到 → 对手进本角色 hits.zss 的 820
        guard.dist: 0;          # 贴身时禁止对手防御
        fall: 1;                # 对手最终倒地
    }
}

if time = 1 {
    call CSnd(800, 0, 1);
}

call EndState(0);


# ============================================================================
# 基础投技 —— 执行：把对手甩出去
#
# 三个必备环节：
#   1) targetBind —— 每个动画元素都必须把对手绑在身上（否则对手会卡住）
#   2) targetLifeAdd —— 投技伤害（不经过 hitDef.damage）
#   3) targetState —— 放开对手，让他进自己的受击/倒地流程
# ============================================================================
[StateDef 810;
type: S; movetype: A; physics: N;
anim: 810;
poweradd: 0;
sprpriority: 1;]

# var(2) 记录投技开始时是否按住前 —— 决定把对手甩向哪边
if time = 0 {
    var(2) := command = "holdfwd";
}

# 抬起：把对手绑在身前
if animElemTime(1) < 0 {
    targetBind{pos: 28, 0}
}
if animElemTime(2) >= 0 && animElemTime(5) < 0 {
    targetBind{pos: 52, -10}
}
if animElemTime(5) >= 0 && animElemTime(6) < 0 {
    targetBind{pos: 44, -40}
}
if animElemTime(6) >= 0 && animElemTime(7) < 0 {
    targetBind{pos: 36, -70}
}

# 若起手时按住前，则转身并把对手甩到身后
if var(2) && animElem = 6 {
    turn{}
    posAdd{x: -30}
    targetFacing{value: -1}
}

# 甩出：脱手 + 结算伤害 + 让对手回到他自己的倒地流程（821 → 5100）
if animElem = 7 {
    targetBind{pos: -30, -50}
    targetLifeAdd{value: -90}
    targetState{value: 821}
}

if animElem = 7 {
    call CSnd(800, 1, 1);
}

call EndState(0);


# ============================================================================
# Special 1「突进直拳」(Dash Straight) —— State 1000 / Anim 1000   [P3 · T4]
#
#   236 + A（命令 QCF_x），**不耗气**。
#
# 定位：**近距离突进技** —— 向前突进约 22 px 打出一记直拳。
#   用途：从普通技取消接进来（lv1/lv2 → lv3），把对手压住。
#
# 帧数据（判定帧 = animElem 6）：起手 9 tick / 判定 4 tick / 收招 21 tick，总 34 tick。
# 伤害 85（单段）。
#
# 与 P2 占位版的差异：
#   1) 近/远两套 hitDef 合并成一套（单段、固定 85）—— 减少"同一招两个数字"
#      带来的验证负担；P2 的 95/85 分支记在 P2 文档里，不再保留。
#   2) 登记链等级 lv3（T7）→ 可被普通技取消进来，也可再取消进 lv4（EX / Super）。
# ============================================================================
[StateDef 1000;
type: S; movetype: A; physics: S;
juggle: 4; velset: 0, 0; ctrl: 0;
anim: 1000;
poweradd: 40;
sprpriority: 2;]

# T7：登记链等级 lv3（必杀技）
if time = 0 {
    call AtkInit(3);
}

# 前冲一小段：让"突进技"真的在位移（总计 22 px）
if animElem = 2 {
    posAdd{x: 14}
}
if animElem = 3 {
    posAdd{x: 8}
}

if animElem = 6 {
    var(4) := 1;                  # T7：判定帧开始 → 打开取消窗口（可接 Super / EX）
    hitDef{
        attr: S, SA;              # SA = Special Attack
        damage: 85, 6;
        animtype: Hard;
        guardflag: MA;
        hitflag: MAF;
        priority: 5, Hit;
        pausetime: 15, 15;
        sparkno: 1;
        sparkxy: -10, -60;
        hitsound: 5, 4;
        guardsound: 6, 0;
        ground.type: Low;
        ground.slidetime: 12;
        ground.hittime: 17;
        ground.velocity: -7;
        airguard.velocity: -2.8, -1.2;
        air.velocity: -4, -3;
        air.hittime: 20;
    }
}

if time = 1 {
    call CSnd(0, 3, 1);
}

call EndState(0);


# ============================================================================
# Special 2「升龙踢」(Rising Kick) —— State 1100 / Anim 1100   [P3 · T4]
#
#   214 + A（命令 QCB_x），**不耗气**。
#
# 定位：**中距离对空技** —— 原地起脚向上踢（判定框高到 y=-131），
#   把空中的对手打飞并强制倒地。用途：对手跳进来时反击。
#
# 帧数据（判定帧 = animElem 7）：起手 12 tick / 判定 5 tick / 收招 24 tick，总 41 tick。
# 伤害 70（单段）。**收招很长** —— 挥空就是大破绽，这是它和 Special 1 的取舍。
#
# ★ 两个必杀技并存时靠这三样东西区分（T4 的验证重点）：
#   命令（QCF_x / QCB_x）、状态号（1000 / 1100）、动画（1000 / 1100）各自独立；
#   路由侧两者都是 lv3、条件互不包含，因此**不存在互相吞掉的问题**。
# ★ 物理上保持 physics: S（不真的跳起来）—— 借 KFM 的 "Smash Kung Fu Upper"
#   表现方式：**判定框向上延伸**，角色本体不离地。这样落地/起身链路
#   完全走原有公共状态，不必额外处理空中物理。
# ============================================================================
[StateDef 1100;
type: S; movetype: A; physics: S;
juggle: 3; velset: 0, 0; ctrl: 0;
anim: 1100;
poweradd: 35;
sprpriority: 2;]

# T7：登记链等级 lv3（必杀技）
if time = 0 {
    call AtkInit(3);
}

# 起手时做一个极小的前压（8 px）：避免贴身时判定框完全包住自己
if animElem = 3 {
    posAdd{x: 8}
}

if animElem = 7 {
    var(4) := 1;                  # T7：判定帧开始 → 打开取消窗口
    hitDef{
        attr: S, SA;
        damage: 70, 6;
        animtype: Up;             # 受击方播"向上飞出"的动画
        guardflag: MA;
        hitflag: MAF;
        priority: 5, Hit;
        pausetime: 14, 14;
        sparkno: 3;
        sparkxy: 0, -110;         # 火花位置高 —— 在头顶
        hitsound: 5, 4;
        guardsound: 6, 0;
        ground.type: Low;
        ground.slidetime: 22;
        ground.hittime: 24;
        ground.velocity: -1.5, -12;   # 地面命中 → 把对手挑起来
        airguard.velocity: -3, -4;
        air.velocity: -1.5, -12;      # 空中命中 → 直接打飞
        air.hittime: 26;
        yaccel: .55;
        fall: 1;                  # ★ 强制倒地（对空技的标准收尾）
        fall.recover: 1;          # 允许受身（对手可以 recovery，属于公平性设计）
    }
}

if time = 1 {
    call CSnd(0, 2, 1);
}

call EndState(0);


# ============================================================================
# EX Special 1「EX 突进直拳」—— State 1010 / Anim 1010   [P3 · T5]
#
#   236 + C（命令 QCF_y），**耗 500 气**。
#
# ★ 气量的"检查 → 扣除"分工（沿用 P2 约定，是本项目唯一写法）：
#   检查在路由层（command.zss：`power >= 500`）
#   扣除在本状态 time = 0 的 powerAdd{value: -500}
#   不把检查放在状态里，否则会先进状态再退出，观感上"抖一下"。
#
# 相对 Special 1 的**明确强化点**（T5 要求至少一项，这里给了三项）：
#   伤害 85 → 130（+53%）
#   突进距离 22 → 32 px
#   新增 fall: 1 强制击倒（普通版打不倒人）
# 代价：气 500 + 收招更长。
# ============================================================================
[StateDef 1010;
type: S; movetype: A; physics: S;
juggle: 5; velset: 0, 0; ctrl: 0;
anim: 1010;
poweradd: 0;                    # 出招本身不集气（它要花气）
sprpriority: 2;]

if time = 0 {
    powerAdd{value: -500}       # ★ 气量扣除在这里
    call AtkInit(4);             # T7：lv4（EX / Super 同层，最高链级）
}

if animElem = 2 {
    posAdd{x: 20}
}
if animElem = 3 {
    posAdd{x: 12}
}

if animElem = 6 {
    var(4) := 1;
    hitDef{
        attr: S, SA;
        damage: 130, 10;
        animtype: Hard;
        guardflag: MA;
        hitflag: MAF;
        priority: 5, Hit;
        pausetime: 18, 18;
        sparkno: 2;
        sparkxy: -10, -60;
        hitsound: 5, 5;
        guardsound: 6, 0;
        ground.type: Low;
        ground.slidetime: 16;
        ground.hittime: 22;
        ground.velocity: -6, -5;
        air.velocity: -5, -4;
        air.hittime: 24;
        fall: 1;                # ★ 强制倒地
    }
}

if time = 1 {
    call CSnd(0, 4, 1);
}

call EndState(0);


# ============================================================================
# Super「超必杀直拳」(Super Dash Straight) —— State 3000 / Anim 3000   [P3 · T6]
#
#   236236 + A（命令 QCF2_x），**耗 1000 气**（气槽上限 2000）。
#
# ★ 这是本项目的第一个 Super。刻意保持简单，只验证这条链：
#     复杂命令 → 气量检查（路由层）→ 气量扣除（本状态）→ 状态 → 动画 → 命中 → 退出
#
#   刻意**不做**的东西（属后续阶段）：
#     不做 superPause 定格、不做镜头/闪光/暗转、不做多段连击、
#     不做成功/失败分身状态（KFM 的 3051 那种）。
#
# 相对 EX 的强化：伤害 130 → 200，突进 32 → 38 px，起手更长（18 tick），
#   并且**命中后不可受身**（fall.recover: 0）—— 这是 Super 应有的压制力。
#
# 帧数据（判定帧 = animElem 7）：起手 18 tick / 判定 6 tick / 收招 25 tick，总 49 tick。
# ============================================================================
[StateDef 3000;
type: S; movetype: A; physics: S;
juggle: 6; velset: 0, 0; ctrl: 0;
anim: 3000;
poweradd: 0;                    # 出招本身不集气（它要花气）
sprpriority: 2;]

if time = 0 {
    powerAdd{value: -1000}      # ★ 气量扣除在这里（Super 的代价）
    call AtkInit(4);             # T7：lv4
}

# 蓄力段的微小位移 + 突进
if animElem = 3 {
    posAdd{x: -6}               # 先微微后坐（蓄力感）
}
if animElem = 4 {
    posAdd{x: 18}
}
if animElem = 5 {
    posAdd{x: 16}
}
if animElem = 6 {
    posAdd{x: 10}
}

if animElem = 7 {
    var(4) := 1;
    hitDef{
        attr: S, HA;            # HA = Hyper Attack
        damage: 200, 12;
        animtype: Hard;
        guardflag: MA;
        hitflag: MAF;
        priority: 6, Hit;
        pausetime: 22, 22;
        sparkno: 2;
        sparkxy: -10, -66;
        hitsound: 5, 5;
        guardsound: 6, 0;
        ground.type: Low;
        ground.slidetime: 26;
        ground.hittime: 30;
        ground.velocity: -8, -6;
        guard.velocity: -12;
        air.velocity: -6, -5;
        air.hittime: 30;
        fall: 1;                # ★ 强制倒地
        fall.recover: 0;        # ★ 不可受身（Super 专属压制）
    }
}

if time = 1 {
    call CSnd(0, 4, 1);
}

call EndState(0);


# ============================================================================
# [StateDef -3] —— 每 tick 执行，且只在角色自己的状态文件内生效
# （与 -1 的区别见架构文档 §4.3）。KFM 用它放落地音效，这里保留同一个位置，
# 供后续角色直接扩展（例如：落地扬灰、脚步声）。
# 模板阶段为空 —— 不为了"看起来完整"塞无意义内容。
# ============================================================================
[StateDef -3]
