; ============================================================================
; KingOfFate — Test Fighter A : 角色常量（.const）   [P3]
;
; 由 _template/_template.const 克隆后按 Fighter A 的定位调整。
; 这些是"数值基线"，不含逻辑。
; 出处与语义：docs/ikemen_character_architecture.md §2.1 与实验 E1
; ============================================================================

; ---------------------------------------------------------------------------
; 战斗基础数值
; ---------------------------------------------------------------------------
[Data]
life                 = 1000   ; 起始体力
power                = 2000   ; ★ 气槽**上限**（不是起始气量！）
                              ;   char.go:3740 `c.powerMax = gi.data.power`；kfm.const
                              ;   原文 "Maximum power character is allowed to have"。
                              ;   对局开始时气量为 0，且**跨回合保留**（P2 实测 V18/V19）。
                              ;
                              ;   ★ P3 相对模板的改动：1000 → 2000。
                              ;   模板的 1000 刚好只够放一次 EX，放不下 1000 气的 Super。
                              ;   Fighter A 的本钱结构 = 1 个 Super（1000）
                              ;     或 2 个 EX（500×2）或 SPECIAL 组合，所以把上限提到 2000。
                              ;   这**不是**第二套气槽 —— 仍然是引擎唯一的 power，
                              ;   只是这个角色的容量更大（合同 §14 允许按角色调）。
                              ;   不写此行的引擎默认上限是 3000（char.go:292）。
attack               = 100    ; 攻击力（越高越强，全局倍率）
defence              = 100    ; 防御力（越高越强，全局倍率）
fall.defence_up      = 50     ; 每次倒地后防御力提升的百分比
liedown.time         = 60     ; 倒地后躺多久才起身（tick）
airjuggle            = 15     ; 空中追打点数总量
sparkno              = 2      ; 命中火花默认动画号
guard.sparkno        = 40     ; 防御火花动画号
KO.echo              = 0      ; 1 = KO 时回声
volume               = 0      ; 音量偏移（负数更轻）
IntPersistIndex      = 60     ; 该索引及以上的整型变量跨回合保留
FloatPersistIndex    = 40     ; 该索引及以上的浮点变量跨回合保留

; ---------------------------------------------------------------------------
; 尺寸与碰撞体
; ground.back/front 就是推挤盒（push box）——E1 里角色撞上对手被挡住的就是它
; height 是对手判断"能不能从头顶跳过去"用的
; ---------------------------------------------------------------------------
[Size]
xscale              = 1       ; 水平缩放
yscale              = 1       ; 垂直缩放
ground.back         = 15      ; 推挤盒：身后宽度
ground.front        = 16      ; 推挤盒：身前宽度
air.back            = 12      ; 空中推挤盒：身后
air.front           = 12      ; 空中推挤盒：身前
height              = 60      ; 身高
attack.dist         = 160     ; 默认攻击距离（AI 会用 const(size.attack.dist) 读）
proj.attack.dist    = 90      ; 投射物默认攻击距离
proj.doscale        = 0       ; 1 = 投射物也跟随缩放
head.pos            = -5,-90  ; 头部大致位置
mid.pos             = -5,-60  ; 腰部大致位置
shadowoffset        = 0       ; 影子垂直偏移
draw.offset         = 0,0     ; 绘制偏移，建议 0,0

; ---------------------------------------------------------------------------
; 速度 —— 单位是"每 tick 的像素位移"
; 这是 P1 实验 E1 直接验证过的：walk.fwd 就是每 tick 的 x 位移
; ---------------------------------------------------------------------------
[Velocity]
walk.fwd                        = 2.4      ; 前进速度
walk.back                       = -2.2     ; 后退速度
run.fwd                         = 4.6, 0   ; 前冲（x, y）
run.back                        = -4.5,-3.8; 后跳（x, y）
jump.neu                        = 0,-8.4   ; 原地跳（x, y）
jump.back                       = -2.55    ; 后跳 x 速度
jump.fwd                        = 2.5      ; 前跳 x 速度
runjump.back                    = -2.55,-8.1 ; 助跑后跳
runjump.fwd                     = 4,-8.1   ; 助跑前跳
airjump.neu                     = 0,-8.1   ; 空中跳
airjump.back                    = -2.55    ; 空中后跳
airjump.fwd                     = 2.5      ; 空中前跳
air.gethit.groundrecover        = -.15,-3.5; 落地受身初速
air.gethit.airrecover.mul       = .5,.2    ; 空中受身速度倍率
air.gethit.airrecover.add       = 0,-4.5   ; 空中受身速度增量
air.gethit.airrecover.back      = -1       ; 受身时按后的额外 x 速度
air.gethit.airrecover.fwd       = 0        ; 受身时按前的额外 x 速度
air.gethit.airrecover.up        = -2       ; 受身时按上的额外 y 速度
air.gethit.airrecover.down      = 1.5      ; 受身时按下的额外 y 速度

; ---------------------------------------------------------------------------
; 运动与摩擦
; ---------------------------------------------------------------------------
[Movement]
airjump.num                                 = 1     ; 允许的空中跳跃次数
airjump.height                              = 35    ; 可以空中跳的最小离地高度
yaccel                                      = .44   ; 垂直加速度
stand.friction                              = .85   ; 站立摩擦
crouch.friction                             = .82   ; 下蹲摩擦
stand.friction.threshold                    = 2     ; 站立时低于此速度即停
crouch.friction.threshold                   = .05   ; 下蹲时低于此速度即停
air.gethit.groundlevel                      = 25    ; 落地判定高度
air.gethit.groundrecover.ground.threshold   = -20   ; 可落地受身的最低高度
air.gethit.groundrecover.groundlevel        = 10    ; 落地受身触地高度
air.gethit.airrecover.threshold             = -1    ; 可空中受身的最低 y 速度
air.gethit.airrecover.yaccel                = .35   ; 空中受身垂直加速度
air.gethit.trip.groundlevel                 = 15    ; 绊倒状态触地高度
down.bounce.offset                          = 0, 20 ; 落地弹起偏移
down.bounce.yaccel                          = .4    ; 落地弹起垂直加速度
down.bounce.groundlevel                     = 12    ; 再次触地高度
down.friction.threshold                     = .05   ; 倒地低于此速度即停

; ---------------------------------------------------------------------------
; 胜利台词（可选）。每个语言段最多 100 条（victory0 - victory99）。
; 定稿角色时填写；此处留空占位。
; ---------------------------------------------------------------------------
;[Quotes]
;victory1 = "..."

; ===========================================================================
; 变量台账（T8 —— 强制约定）
;
; 新增任何 var / fvar / sysVar / map 之前先在这里登记。
; 不做台账是后期最典型的"改 A 坏 B"来源 —— KFM 自己也留了这样一段。
;
; 分区约定：
;   var(0)  - var(9)    系统层：取消 / 投技 / 集气，本项目占用，后续角色不要抢
;   var(10) - var(39)   角色私有：正式角色自由使用
;   var(40) - var(59)   AI 私有：AI.zss 使用
;   var(60) - var(...)  跨回合保留（IntPersistIndex = 60 及以上）
;   fvar(0) - fvar(39)  角色私有浮点；fvar(40)+ 跨回合保留
;   sysVar(0..)         引擎/公共状态使用，角色只读
; ===========================================================================

; --- 系统层（本项目占用，不要改用途）-----------------------------------------
; var(0)   cancelUsed   = 1 表示**当前这一招**已经取消过一次。
;                         由 AtkInit() 在进入任何攻击状态时清零，取消发生时置 1。
;                         （真正的防无限连段靠 var(3) 的等级递增，var(0) 是
;                          同一状态内的二重保险。）
; var(1)   aiCooldown   = AI 的特殊技冷却计数（tick）。>0 时 AI 不出必杀 / EX / Super。
;                         在 AI.zss 里递减。
; var(2)   throwDirFwd  = 1 表示本次投技起手时按的是"前"（前投），
;                         0 表示按的是"后"（后投）。由 State 810 的 time = 0
;                         写入，决定把对手甩向哪一侧（见 test_fighter_a.zss 810）。
; var(3)   chainLevel   = ★ P3 新增（T7）：当前攻击状态的链等级。
;                         0 = 非攻击状态 / 1 = 轻普通技 / 2 = 重普通技
;                         3 = 必杀技 / 4 = EX·Super。由 AtkInit(lv) 写入。
;                         取消放行要求"目标等级 > var(3)"（command.zss CanChain）。
; var(4)   cancelOpen   = ★ P3 新增（T7）：当前攻击的取消窗口是否已开启。
;                         0 = 判定帧还没到 / 1 = 判定帧已开始，可取消。
;                         由每个攻击状态在自己的首个判定帧置 1（与 hitDef 同帧）。
; --- 角色私有（留给 Fighter A / B）-----------------------------------------
; var(10)  -（未占用）
; var(11)  -（未占用）
; --- AI 私有 ----------------------------------------------------------------
; var(40)  -（未占用）
; var(41)  -（未占用）
; --- 浮点 --------------------------------------------------------------------
; fvar(0)  -（未占用）
; --- 命名变量（map）----------------------------------------------------------
; map("canCombo")  当前是否处于"可出必杀技"的窗口（= CanChain(3) 的结果）。
;                  由 command.zss 的 [StateDef -1] 每 tick 写入。只读，不跨帧存储。
; ===========================================================================
