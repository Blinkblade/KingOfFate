; ---------------------------------------------------------------------------
; 站立轻拳 A（Stand Light Punch）—— 对应 StateDef 200
;
; ★ 这份是**新招式的复制样板**。结构：
;   帧1 (2 tick)  起手，只有受击框
;   帧2 (1 tick)  过渡，只有受击框
;   帧3 (4 tick)  ★ 攻击帧：同时有 Clsn1 攻击框 和 Clsn2 受击框
;   帧4 (3 tick)  收招：Clsn1: 0 关掉攻击框
;   帧5 (10 tick) 回位（收招段刻意加长：LP 总长 20 tick，与 KFM 同级，
;                 同时让取消窗口（攻击帧之后到动画结束）足够长、
;                 可被 tests/p2 的合成输入稳定观测）
; 总时长 2+1+4+3+10 = 20 tick
;
; hitDef 在 animElem = 3 触发 → 正好是上面"帧3"的第一帧
; ---------------------------------------------------------------------------
[Begin Action 200]
Clsn2Default: 2
 Clsn2[0] = -10,  0, 19,-80
 Clsn2[1] =   0,-94, 12,-80
200,0, 0,0, 2
200,1, 0,0, 1
Clsn1: 1
 Clsn1[0] =  16,-80, 61,-71
Clsn2: 3
 Clsn2[0] =  19,  0,-10,-80
 Clsn2[1] =   6,-94, 18,-78
 Clsn2[2] =  19,-80, 61,-71
200,2, 0,0, 4
Clsn1: 0
Clsn2: 2
 Clsn2[0] = -10,  0, 19,-80
 Clsn2[1] =   0,-94, 12,-80
200,1, 0,0, 3
200,0, 0,0, 10

