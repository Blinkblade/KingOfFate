# ============================================================================
# KingOfFate — Test Fighter B（P4，Zoner）：CPU AI（AI.zss）
#
# ★★★ 两条必须记住的机制（P1 实验 E6 直接验证）★★★
#
#   1. AI **不走命令系统**。它不模拟按键、不看 .cmd、不看 command.zss，
#      而是直接 `changeState{value: N}`。
#      → 所以改 .cmd 不会影响 AI；反过来，AI 能做出的动作不受命令定义限制。
#        代价：AI 的招式分散度**完全靠自己写**，不会"自动学会"角色的新招。
#
#   2. **优先级 = 本文件的书写顺序**。同一个 tick 里，先出现的 changeState
#      先生效，没有权重、没有评分、没有回退。
#      → 一条写得太靠前、条件太宽的规则会**静默废掉它后面的一切**。
#
# 因此：**顺序表就是这个 AI 的设计本身**，不是实现细节。
#
# P4 的范围（合同 §14）：仍然是**规则 AI**，不是 Utility AI（那属 P9）。
# 要求：Fighter B 的 AI 必须表现出 **Zoner 行为分布**，而不是照抄 Fighter A。
#
# ---------------------------------------------------------------------------
# ★ Fighter A 的 AI 与 Fighter B 的 AI 差在哪（P4 要回答的问题 6）
#
#   Fighter A（Rushdown）：距离越近越活跃，末位规则是"接近"（走向对手）。
#   Fighter B（Zoner）  ：距离越**远**越活跃，末位规则是"拉开"（后跳/后退）。
#
#   具体到顺序表：
#     Fighter A ② 对空（升龙踢）之后，③④⑤ 全部要求 **中距离 45–130**；
#     Fighter B ⑥ 投射物要求 **远距离 ≥ 110**，是它最高频的进攻手段；
#        ⑦⑧ 才是中距离牵制，⑨ 近身只做应急。
#     末位：Fighter A 是"距离 ≥ 45 就走过去"（贴近），
#           Fighter B 是"距离 < 45 就后跳、距离 75–165 就走位调整发波距离"（维持空间）。
#
# ---------------------------------------------------------------------------
# 本角色的顺序表（改顺序 = 改行为，必须重跑 Runtime 验证）：
#
#   ① 防御        对手正在攻击且在防御距离内 → 公共状态 120
#   ② 对空必杀    对手在空中 + 25–160 + 冷却结束 → 1100（升龙上勾拳）
#   ③ 对空 Normal 对手在空中 + 很近 → 410（蹲重拳，快但够不到高）
#   ④ Super       Power ≥ 1000 + 远距离 + 冷却 + 概率 → 3000
#   ⑤ EX          Power ≥ 500  + 中远距离 + 冷却 + 概率 → 1010
#   ⑥ Projectile  远距离（≥ 95）+ 冷却结束 → 1000    ★ Zoner 主力手段
#   ⑦ 长手牵制    中距离 55–140 → 210（判定到 x=105）★ 第二手段
#   ⑧ 中距离普通技 35–75 → 240 / 230 / 440（按概率分摊）
#   ⑨ 近身普通技   < 45 → 200 / 430（应急，不是主要输出）
#   ⑩ 投技         贴身（< 12）+ 概率 → 800（把对手推开）
#   ⑪ 后跳拉开     < 70 时概率后跳 → 公共状态 105  ★ Zoner 的"逃避"行为
#
#   ★ 本角色**故意没有**"走路兜底"规则（Fighter A 有 ⑧"走向对手"）。
#     原因见文件内 ⑪ 之后的详细说明：AI 不走命令系统 ⇒ 走路方向由引擎的
#     默认 AI 方向（朝对手）决定 ⇒ 对 Zoner 是反效果。
#
# ---------------------------------------------------------------------------
# ★ 为什么 ④⑤ 都有"概率闸门"（random）：两条的距离波段有重叠
#   （④ 是 100+，⑤ 是 60+）。如果 ④ 只写 `power >= 1000`，那么只要气够，
#   ⑤ 永远轮不到 —— 那就正好犯了 E6 的错（一条宽条件吞掉后面全部）。
#   加上 `random <= N` 之后两条各自的触发概率独立，都能被观测到。
#
# ★ ⑥ 是唯一**没有 random 闸门**的进攻规则，因为它靠 `var(1)` 冷却节流
#   （90 tick），行为上就是"每隔一段时间发一枚"。这是刻意的：
#   投射物是 Zoner 的主要手段，不该用概率压制它的出现频率。
#
#   阈值取 95 px（不是 110）：P4 实测发现，若要求 110，本角色后跳一次
#   （后跳位移约 30–50 px）之后仍然够不到发波距离，AI 会在整局里几乎不放波 ——
#   那不是"Zoner 行为分布不同"，而是"这条规则失效"。95 px 让它稳定可见。
#
# ★ 波段刻意错开，避免规则互相吞并：
#     ⑥  ≥ 95         （远）
#     ⑦  55–140       （中；与 ⑥ 有重叠，靠"⑥ 无冷却要求更宽"分层：
#                      ⑥ 先判 —— 但 ⑥ 有 var(1) = 0，冷却中就会落到 ⑦）
#     ⑧  35–75
#     ⑨  < 45
#     ②③ 额外要求"对手在空中"，与地面规则不冲突
#
# 依据：docs/ikemen_character_architecture.md §7
# 实测对照：game/chars/test_fighter_a/AI.zss
# ============================================================================


# ============================================================================
# [StateDef -4] —— 全局状态
# 非战斗状态下的收尾：例如跑动状态在回合结束后要强制解除。
# ============================================================================
[StateDef -4]

if stateNo = 100 && roundState != 2 && aiLevelF {
    changeState{value: 0; ctrl: 1}
}


# ============================================================================
# [StateDef -1] —— AI 主循环（每 tick）
# ============================================================================
[StateDef -1]

# 只在"战斗中 + 由 AI 操作 + 不是待机/暂停"时决策。
# ignoreHitPause = 命中停顿期间也要继续思考。
ignoreHitPause if aiLevelF && roundState = 2 && !standby {

    # ------------------------------------------------------------------------
    # 关闭引擎的默认自动行为 —— 移动/跳跃必须由 AI 自己决定
    # ------------------------------------------------------------------------
    assertSpecial{flag: nojump; flag2: noairjump}   # 禁默认跳跃
    assertSpecial{flag: nowalk; flag2: nobrake}     # 禁默认走路

    # ------------------------------------------------------------------------
    # 派生量（每 tick 算一次，后面所有规则复用）
    # ------------------------------------------------------------------------
    let grounded = p2StateType = S || p2StateType = C;   # 对手在地面
    let p2air = p2StateType = A;                          # 对手在空中
    let closeR = p2BodyDist x < 45;                       # 近距离
    let midR = p2BodyDist x = [35, 75];                   # 中距离（牵制）
    let longR = p2BodyDist x = [55, 140];                 # 长手距离
    let farR = p2BodyDist x >= 95;                        # 远距离（发波）

    # var(1) = 特殊技冷却（tick）。见 .const 的变量台账。
    # 没有它，AI 会在冷却结束前每 tick 都试图出必杀技。
    if var(1) > 0 {
        var(1) := var(1) - 1;
    }

    # ========================================================================
    # ① 防御 —— 复用公共状态 120（GUARDSTART, stand）
    # 条件刻意收紧：只在"对手正在攻击且在防御距离内"时触发，
    # 否则它会吃掉后面所有进攻规则。
    # ========================================================================
    if ctrl && stateType != A && p2MoveType = A && inGuardDist {
        assertSpecial{flag: autoguard}
        changeState{value: 120}
    }

    # ========================================================================
    # ② 对空必杀 —— State 1100「升龙上勾拳」
    # 只在**对手真的在空中**时使用：这就是这招的设计用途，
    # 也是"AI 真的会防空"的证据。判定框到 y = -152（见 .zss 的 1100）。
    # ★ 排在最前面（防御之后）—— Zoner 最怕的就是被跳进来，
    #   优先级必须高于一切进攻规则。
    # ========================================================================
    if ctrl && stateType = S && $p2air && var(1) = 0 && p2BodyDist x = [25, 160] {
        changeState{value: 1100}
        var(1) := 120;
    }

    # ========================================================================
    # ③ 对空 Normal —— State 410「蹲重拳」（判定到 y = -112）
    # 对手在空中且已经很近时用：1100 起手 12 tick 太慢，410 只要 8 tick。
    # 与 ② 的分工是"距离/速度"，不是"随便挑一个"。
    # ========================================================================
    if ctrl && stateType != A && $p2air && p2BodyDist x < 45 && random <= 600 {
        changeState{value: 410}
    }

    # ========================================================================
    # ④ Super —— State 3000（Power ≥ 1000，3 连发气弹）
    # 概率闸门保证它不会吞掉 ⑤ ⑥（见文件头说明）。
    # ========================================================================
    if ctrl && stateType = S && $grounded && var(1) = 0 &&
        power >= 1000 && p2BodyDist x = [100, 320] && random <= 250 {
        changeState{value: 3000}
        var(1) := 200;
    }

    # ========================================================================
    # ⑤ EX —— State 1010（Power ≥ 500，双气弹）
    # ========================================================================
    if ctrl && stateType = S && $grounded && var(1) = 0 &&
        power >= 500 && p2BodyDist x = [60, 320] && random <= 400 {
        changeState{value: 1010}
        var(1) := 160;
    }

    # ========================================================================
    # ⑥ Projectile —— State 1000（气弹），**Zoner 的主力手段**
    # 远距离就发弹。这是与 Fighter A 最大的行为差异：
    # Fighter A 在这个距离会"走向对手"，Fighter B 会"隔空开火"。
    # 冷却 90 tick（约 1.5 s）→ 一场对局里能稳定观测到多轮发弹。
    # ========================================================================
    if ctrl && stateType = S && $grounded && var(1) = 0 && $farR {
        changeState{value: 1000}
        var(1) := 90;
    }

    # ========================================================================
    # ⑦ 长手牵制 —— State 210（判定到 x = 105）
    # 中距离的第二手段：把"想接近的对手"挡在外面。
    # ========================================================================
    if ctrl && stateType = S && $grounded && $longR && random <= 500 {
        changeState{value: 210}
    }

    # ========================================================================
    # ⑧ 中距离普通技 —— 三条各自的概率闸门独立（避免互相吞掉）
    # ========================================================================
    # ⑧a 站立重脚 D（240）：伤害最高
    if ctrl && stateType = S && $grounded && $midR && random <= 250 {
        changeState{value: 240}
    }
    # ⑧b 站立轻脚 B（230）：稍远、更快
    if ctrl && stateType = S && $grounded && $midR && random <= 250 {
        changeState{value: 230}
    }
    # ⑧c 蹲重脚 D（440）：下段扫腿，逼对手换防
    if ctrl && stateType = S && $grounded && $midR && random <= 180 {
        changeState{value: 440}
    }

    # ========================================================================
    # ⑨ 近身普通技 —— 应急，不是主要输出（Zoner 不该待在这个距离）
    # ========================================================================
    # ⑨a 站立轻拳 A（200）：最快
    if ctrl && stateType = S && $grounded && $closeR && random <= 450 {
        changeState{value: 200}
    }
    # ⑨b 蹲轻脚 B（430）：下段
    if ctrl && stateType = S && $grounded && $closeR && random <= 300 {
        changeState{value: 430}
    }

    # ========================================================================
    # ⑩ 投技 —— 贴身时使用。
    # 对 Zoner 而言它的意义是"把贴住的对手推开"，所以排在普通技之后、
    # 后跳之前。概率带 aiLevelF，保证低难度 AI 确实更少用。
    # ========================================================================
    if ctrl && stateType = S && $grounded && p2MoveType != H &&
        p2BodyDist x < 12 && random <= (200 * (aiLevelF ** 2 / 48.0)) {
        changeState{value: 800}
    }

    # ========================================================================
    # ⑪ 后跳拉开 —— ★ Zoner 的标志性行为（与 Fighter A 的"接近"完全相反）
    # 对手进入中近距离就主动跳到后方，重新拿回"能发波"的空间。
    # 排在这里（普通技/投技之后）是因为"先反击、再脱离"比"只顾逃"更合理。
    # 公共状态 105 = 后跳（有确定的后向位移，实测有效）。
    # ========================================================================
    if ctrl && stateType = S && stateNo != 105 && p2BodyDist x < 70 && random <= 400 {
        changeState{value: 105}
    }

    # ========================================================================
    # ★★ 这里**故意不放"走路"规则**（P4 实测踩到，合同 §14 要求"不要让一条宽
    #    条件吞掉后面所有动作"的另一面：也不要放一条方向错误的兜底规则）★★
    #
    # 起因：P4 最初写过 `p2BodyDist x = [75, 165] → changeState{value: 20}`
    #   （公共状态 20 = 走路），本意是"把距离调整到能发波的那一档"。
    # 结果：第一次 AI 对局截图（logs/p3/shots/g4_aivb_03.png）里两个角色**贴在
    #   一起**，B 完全没有拉开距离 —— 因为 AI **不走命令系统**（本文件头第 1 条），
    #   进入状态 20 之后 `command = "holdfwd"/"holdback"` 由**引擎给出的 AI 方向
    #   输入**决定，而引擎的默认方向就是"朝对手"。于是这条规则把 Zoner 变成了
    #   第二个 Rushdown，正好和角色定位相反。
    # → 修法：删掉这条兜底走路，只用**有确定位移方向**的公共状态（105 后跳）
    #   来表达"拉开"。这是 P4 回答"Zoner AI 能否形成不同行为分布"时踩到的坑。
    #
    # ★ 顺带纠正一个会误导所有后续角色的文档错误：
    #   走路**只有一个状态号 20**，**没有状态 21**。
    #   `common1.cns.zss:73-88` 的 [StateDef 20] 按 holdback/holdfwd 设速度，
    #   再按速度方向选**动画** 20（前）或 21（后）—— 21 是**动画号**。
    #   写 `changeState{value: 21}` 会被引擎判为非法状态并打印
    #   `in state 21: changed to invalid state 21`（P4 首次 AI 对局的实测原话，
    #   见 logs/p3/shots/g3_aivb_05.png）。
    #   `_template/README.md` §5 的表格与 `_template.air` 的注释已一并修正。
    # ========================================================================

}

# ============================================================================
# 顺序自查清单（每改一次顺序都要过一遍）
#
#   [ ] 有没有哪条规则的条件宽到会"吃掉"后面所有规则？
#       （特别注意 ④⑤ 距离波段有重叠，靠 random 闸门 + Power 条件区分）
#   [ ] 移动类规则（⑪⑫）是否都排在攻击类规则之后？
#   [ ] 概率系数是否都带了 aiLevelF，以保证低难度确实更弱？
#   [ ] 新增的 changeState 目标状态是否真的存在（拼错状态号 = 静默无反应）？
#   [ ] 这个 AI 的**末位规则方向**是否与角色定位一致？
#       （Rushdown → 接近；Zoner → 拉开。写反了角色性格就没了。）
#
# 验证方法：跑一局 AI vs AI，用 Ctrl+D 读状态号序列，
#           确认状态号是**多样**的（应能同时看到 1000/1010 的投射物、
#           1100/410 的对空、200/230/240/440 的普通技、150 的防御），
#           而不是塌缩成一两个。
# ============================================================================
