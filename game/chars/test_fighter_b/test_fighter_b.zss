# ============================================================================
# KingOfFate — Test Fighter B（P4，Zoner）：主体状态脚本（ZSS）
#
# 本文件是 Test Fighter B 的状态主体：每个 [StateDef N] 是一个状态。
# 命令名 → 状态号的映射在 command.zss，不在本文件。
# 由 game/chars/_template/ 克隆（P4）后扩展而来，实现样板参照 Test Fighter A。
#
# 本角色实现的状态：
#   180   胜利姿势        —— 回合结束时引擎要求的状态（占位，继承自模板）
#   195   嘲讽            —— 非攻击状态样板（继承自模板）
#   200   站立轻拳 A      —— lv1 轻普通技（贴身应急）
#   210   站立重拳 C      —— lv2 重普通技 ★ **长手牵制（Long Range Normal）**
#   230   站立轻脚 B      —— lv1 轻普通技（中距离）
#   240   站立重脚 D      —— lv2 重普通技（中距离高伤）
#   400   蹲轻拳 A        —— lv1 轻普通技（下段）
#   410   蹲重拳 C        —— lv2 重普通技 ★ **对空 Normal（Anti-Air Normal）**
#   430   蹲轻脚 B        —— lv1 轻普通技（下段）
#   440   蹲重脚 D        —— lv2 重普通技，扫腿击倒（下段）
#   600   跳轻拳 A        —— lv1 空中轻普通技
#   610   跳重拳 C        —— lv2 空中重普通技
#   630   跳轻脚 B        —— lv1 空中轻普通技
#   640   跳重脚 D        —— lv2 空中重普通技
#   800   投技起手        —— hitDef 抓人，成功后 p1stateno 810 / p2stateno 820
#   810   投技执行        —— targetBind + targetLifeAdd + targetState 821
#   1000  Projectile「气弹」      236 + A             不耗气
#   1010  EX Projectile「双气弹」 236 + C             耗 500 气
#   1100  Anti-Air「升龙上勾拳」  623 + A             不耗气
#   3000  Super「气弹炮」         236236 + A          耗 1000 气
#
# 由 hits.zss（受击方，本角色自己的状态）实现的：
#   820  被抓住（等待被甩出）   —— changeAnim2 播攻击者的 AIR
#   821  被甩到空中 → 触地 5100，含受身（recovery → 5200 / 5210）
#
# 由 IKEMEN Common State 提供、本角色**不重复实现**的：
#   0/10/11/12  站立 / 站↔蹲
#   20/21       走前 / 走后
#   40-52       跳跃（起跳 / 上升 / 空中 / 下落 / 落地）★ 52 = 落地
#   100/105     前冲 / 后跳
#   120/130-155 防御（起手 / 站防 / 蹲防 / 空防 / 防御结束 / 防御后退）
#   5000-5210   受击 / 倒地 / 起身 / 受身
#   出处：engine/ikemen-go/data/common1.cns.zss
#
# ★★★ 普攻取消链（沿用 P3 的等级系统，未新建第二套）★★★
#   每个攻击状态在 time = 0 调用 AtkInit(lv) 登记"链等级"，并在首个判定帧
#   把 var(4) 置 1（= 取消窗口开启）。路由侧放行条件是**严格的等级递增**：
#
#       lv1 轻普通技（200/230/400/430/600/630）
#         ↓
#       lv2 重普通技（210/240/410/440/610/640）
#         ↓
#       lv3 必杀技（1000/1100）
#         ↓
#       lv4 EX（1010）/ Super（3000）
#
#   等级只增不减 → 连段长度天然有上限（最长 4 段）。等级表与放行逻辑见
#   command.zss 的 [Function CanChain] —— 与 Fighter A **同一套机制**，
#   只是角色自己的等级表不同（本角色的 lv3 是投射物与对空技）。
#
# ★★★ Projectile（本阶段最重要的新机制）★★★
#   用 IKEMEN **原生** `projectile{}` 状态控制器实现（compiler.go:98 注册，
#   参数表见 compiler_functions.go 的 projectileSub）。没有用 Helper 方案，
#   也没有改引擎 —— 理由见 README §Projectile。
#
#   ★ 为什么每处发射都带 `var(10)` 闩锁：
#     `animElem = N` 在**第 N 个元素的整个持续时间内**都为真（不是只在第一帧）。
#     所以 `if animElem = 4 { projectile{...} }` 会按元素时长重复生成多枚 ——
#     这正是合同 §11.1 点名要防的"重复生成失控 / 投射物泄漏"。
#     本文件的做法：进入状态时 `var(10) := 0`，每发射一次 `var(10) += 1`，
#     发射条件写成 `animElem = N && var(10) = <期望值>` → 每个发射点恰好一次。
#     实测：普通版每次恰好 1 枚、EX 恰好 2 枚、Super 恰好 3 枚（Phase Report Gate 7）。
#
# 语法硬规则（架构文档 §5.2）：
#   * sctrl 的左花括号必须与控制器名同行：  hitDef{   ✅   hitDef   ❌
#   * [StateDef N; ...] 头部用分号分隔、] 收尾
#   * 触发器就是 if <表达式> { ... }，不用 trigger1 = 的旧写法
#   * `call` 语句与 `var(n) := x` 都要写分号；`call` 不能内联在 if 条件里
#
# 实测对照：game/chars/test_fighter_a/test_fighter_a.zss
# ============================================================================


# ============================================================================
# 函数
# ============================================================================
# EndState(type)：状态结束后回到站立（type=0）或下蹲（type=1）。
# 每个攻击状态都必须用它收尾，否则状态无法退出（架构文档 §5.4 第 5 条）。
[Function EndState(type)]
if animTime = 0 {
    changeState{value: 11 * $type; ctrl: roundState > 1}
}

# CSnd(bank, sound, channel)：播放本角色 .snd 里的音效。
[Function CSnd(bank, sound, c)]
playSnd{value: S $bank, $sound; channel: $c}

# AtkInit(lv)：攻击状态进入时统一登记"我是谁、能不能取消"。
#   var(3) = 链等级（1 轻 / 2 重 / 3 必杀 / 4 EX·Super）
#   var(4) = 取消窗口是否已开启（0 关闭 / 1 开启），在首个判定帧置 1
#   var(0) = 本次攻击是否已经取消过一次（进状态时清零）
[Function AtkInit(lv)]
var(3) := $lv;
var(4) := 0;
var(0) := 0;

# ProjInit()：投射物类状态进入时调用（P4）。
#   var(10) = 本次状态已经生成的投射物数量（见文件头"为什么带闩锁"）
[Function ProjInit()]
var(10) := 0;


# ============================================================================
# 胜利姿势（Win Pose）—— 回合结束时引擎会把胜者切到这个状态
# 缺了它会打印 `changed to invalid state 180`（P2 审计实测）。继承自模板。
# ============================================================================
[StateDef 180;
type: S; movetype: I; physics: S;
anim: 180; ctrl: 0;
velset: 0, 0;
sprpriority: 1;]

notHitBy{value: SCA; time: 1}


# ============================================================================
# 嘲讽（Taunt）—— 非攻击状态的最小样板（继承自模板）
# ============================================================================
[StateDef 195;
type: S; movetype: I; physics: S;
anim: 195; ctrl: 0;
velset: 0, 0;
sprpriority: 2;]

if time = 40 {
    ctrlSet{value: 1}
}

call EndState(0);


# ============================================================================
# 站立轻拳 A（Stand Light Punch）—— lv1
#
# Zoner 被贴住时的唯一应急手段：起手 3 tick（全套最快），判定只到 x=58。
# 本角色不靠它打输出，靠它把对手推开、给自己争取发弹的距离。
# ============================================================================
[StateDef 200;
type: S; movetype: A; physics: S;
juggle: 1; velset: 0, 0; ctrl: 0;
anim: 200;
poweradd: 20;
sprpriority: 2;]

if time = 0 {
    call AtkInit(1);
}

if animElem = 3 {
    var(4) := 1;                  # 判定帧开始 → 打开取消窗口
    hitDef{
        attr: S, NA;
        damage: 25, 0;
        animtype: Light;
        guardflag: MA;
        hitflag: MAF;
        priority: 3, Hit;
        pausetime: 8, 8;
        sparkno: 0;
        sparkxy: -10, -76;
        hitsound: 5, 0;
        guardsound: 6, 0;
        ground.type: High;
        ground.slidetime: 5;
        ground.hittime: 11;
        ground.velocity: -5;
        airguard.velocity: -1.9, -.8;
        air.type: High;
        air.velocity: -1.4, -3;
        air.hittime: 15;
    }
}

if time = 1 {
    call CSnd(0, 0, 1);
}

call EndState(0);


# ============================================================================
# ★★★ 站立重拳 C（Stand Heavy Punch）—— **长手牵制（Long Range Normal）** ★★★
#
#   本角色"控制空间"的第一件工具。
#
# 几何：判定框伸到 **x = 105**（Fighter A 最长的站重脚只有 84）。
#       攻击框在 .air 的 Action 210 里画成两段（30→105 与 62→98），
#       覆盖"从胸口高度平推出去的一条长臂"。
#
# ★ 长手不是白给的 —— 三样代价同时付（合同 §10.2 要求"不要用瞬移伪装长手"）：
#     起手 14 tick（Fighter A 的 210 是 10）—— 反应慢，可以被抢先
#     收招 15 tick（Fighter A 是 11）—— 挥空即被罚
#     伤害 60（Fighter A 是 70）—— 长手不该同时高伤
#   ★ 本状态**没有任何 posAdd** —— 角色本体不前进，长的是判定框。
#     这正是"长手"与"突进技"的区别，也是 Gate 4 的验证点之一。
#
# 定位用途：中距离（对手 60–100 px 外）用它挡住接近路线，逼对手跳。
# ============================================================================
[StateDef 210;
type: S; movetype: A; physics: S;
juggle: 2; velset: 0, 0; ctrl: 0;
anim: 210;
poweradd: 28;
sprpriority: 2;]

if time = 0 {
    call AtkInit(2);
}

if animElem = 5 {
    var(4) := 1;
    hitDef{
        attr: S, NA;
        damage: 60, 4;
        animtype: Medium;
        guardflag: MA;
        hitflag: MAF;
        priority: 4, Hit;
        pausetime: 12, 12;
        sparkno: 1;
        sparkxy: -10, -70;
        hitsound: 5, 2;
        guardsound: 6, 0;
        ground.type: High;
        ground.slidetime: 9;
        ground.hittime: 16;
        ground.velocity: -7;
        airguard.velocity: -2.6, -1.1;
        air.type: High;
        air.velocity: -2.4, -4;
        air.hittime: 20;
    }
}

if time = 1 {
    call CSnd(0, 1, 1);
}

call EndState(0);


