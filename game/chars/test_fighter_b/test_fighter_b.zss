        guardflag: MA;
        hitflag: MAF;
        priority: 6, Hit;
        pausetime: 14, 14;
        sparkno: 2;
        sparkxy: -10, -74;
        hitsound: 5, 5;
        guardsound: 6, 0;
        ground.type: High;
        ground.slidetime: 12;
        ground.hittime: 20;
        ground.velocity: -8;
        airguard.velocity: -3, -1.3;
        air.velocity: -3.4, -4.2;
        air.hittime: 24;
    }
}

# 第 2 发：中
if animElem = 7 && var(10) = 1 {
