# ============================================================================
# 基础投技 —— 起手：抓人（继承模板，未修改）
#
# Zoner 的投技意义与 Fighter A 不同：不是为了打伤害，而是**把贴住自己的对手
# 推开**，重新拿到发弹的距离。所以它在 AI 里被放在"对手贴身"这一档。
# ============================================================================
[StateDef 800;
type: S; movetype: A; physics: S;
juggle: 0; velset: 0, 0; ctrl: 0;
anim: 800;
poweradd: 10;
sprpriority: 2;]

if time = 0 {
    hitDef{
        attr: S, NT;            # Standing, Normal Throw
        hitflag: M-;
        priority: 1, Miss;
        sparkno: -1;
        p1sprpriority: 1;
        p1facing: 1;
        p2facing: 1;
        p1stateno: 810;
        p2stateno: 820;
        guard.dist: 0;
        fall: 1;
    }
}

if time = 1 {
    call CSnd(800, 0, 1);
}

call EndState(0);


# ============================================================================
# 基础投技 —— 执行：把对手甩出去（继承模板，未修改）
# ============================================================================
[StateDef 810;
type: S; movetype: A; physics: N;
anim: 810;
poweradd: 0;
sprpriority: 1;]

if time = 0 {
    var(2) := command = "holdfwd";
}

if animElemTime(1) < 0 {
    targetBind{pos: 28, 0}
}
if animElemTime(2) >= 0 && animElemTime(5) < 0 {
    targetBind{pos: 52, -10}
}
if animElemTime(5) >= 0 && animElemTime(6) < 0 {
    targetBind{pos: 44, -40}
}
if animElemTime(6) >= 0 && animElemTime(7) < 0 {
    targetBind{pos: 36, -70}
}

if var(2) && animElem = 6 {
    turn{}
    posAdd{x: -30}
    targetFacing{value: -1}
}

if animElem = 7 {
    targetBind{pos: -30, -50}
    targetLifeAdd{value: -90}
    targetState{value: 821}
}

if animElem = 7 {
    call CSnd(800, 1, 1);
}

call EndState(0);


# ============================================================================
# ★★★ Projectile Special「气弹」(Ki Blast) —— State 1000 / Anim 1000 ★★★
#
#   236 + A（命令 QCF_x），**不耗气**。
#
# 这是 P4 最关键的新机制。实现选择与理由：
#
# ★ 用 IKEMEN **原生** `projectile{}` sctrl，**不用 Helper**。
#   理由：引擎已提供完整能力（生成 / 速度 / 生命周期 / 命中次数 / 优先级 /
#   与角色状态解耦），compiler.go:98 与 compiler_functions.go 的 projectileSub
#   给出了全部参数。用 Helper 相当于在角色层手搓一个投射物系统 ——
#   违反合同 §11.1 的"优先使用 IKEMEN 已有的角色层能力"与 §29 的"禁止自造框架"。
#
# ★ 生命周期四道闸门（合同 §11.1 要求"防止永久残留 / 数量失控"）：
#     ① projhits: 1         —— 命中一次即消失（防"命中后重复命中"）
#     ② projremovetime: 130 —— 生成后 130 tick 强制消失（兜底，防止无限飞行）
#     ③ projedgebound / projstagebound: 40 —— 飞出边界 40 px 即消失
#     ④ var(10) 闩锁        —— 每次状态执行恰好生成 1 枚（防重复生成失控）
#   这四条都是**显式写出**的，不依赖引擎默认值（默认 projhits 就是 1、
#   removetime 是 -1 —— 显式写出来才算"设计"，而不是"碰巧"）。
#
# ★ 与角色状态解耦（合同 §11.1 明确要求验证）：
#   projectile 一旦生成就拥有自己的 pos / velocity / anim（char.go 的 Projectile
#   结构体），角色之后出招、收招、甚至被打都不影响它。
#
# 伤害 60、速度 6 px/tick。Zoner 的投射物不该一炮致命，它的价值在于
# "逼对手做选择"（防御 / 跳 / 前冲 / 吃）。
#
# 帧序（.air 的 Action 1000）：到发射 9 tick / 总 42 tick（发射帧 = elem 4）
# ============================================================================
[StateDef 1000;
type: S; movetype: A; physics: S;
juggle: 4; velset: 0, 0; ctrl: 0;
anim: 1000;
poweradd: 40;
sprpriority: 2;]

if time = 0 {
    call AtkInit(3);              # lv3 = 必杀技（可被 lv1/lv2 取消进来）
    call ProjInit();              # var(10) := 0（投射物计数）
}

# ★ 发射：animElem = 4 会持续整个元素时长，所以必须配闩锁，否则一次出招
#   会生成多枚（元素 4 持续 3 tick → 3 枚）。这就是 var(10) 的用处。
if animElem = 4 && var(10) = 0 {
    var(10) := 1;
    projectile{
        projanim: 1005;
        projid: 1000;
        postype: p1;
        offset: 34, -40;          # 从身前胸高发出（判定框见 .air 的 Action 1005）
        velocity: 6, 0;           # 每 tick 前进 6 px（方向由朝向决定）
        projhits: 1;              # ① 命中 1 次即消失
        projremovetime: 130;      # ② 130 tick 后强制消失（约 2.2 s）
        projpriority: 1;          # 与对手投射物对撞时的优先级
        projmisstime: 0;
        projsprpriority: 3;       # 画在角色前面
        projedgebound: 40;        # ③ 飞出屏幕边界 40 px 即消失
        projstagebound: 40;
        attr: S, SP;              # SP = Special Projectile
        damage: 60, 6;
        animtype: Medium;
        guardflag: MA;
        hitflag: MAF;
        priority: 4, Hit;
        pausetime: 11, 11;
        sparkno: 0;
        sparkxy: -10, -60;
        hitsound: 5, 1;
        guardsound: 6, 0;
        ground.type: High;
        ground.slidetime: 9;
        ground.hittime: 16;
        ground.velocity: -6;
        airguard.velocity: -2.6, -1.1;
        air.velocity: -2.6, -3.8;
        air.hittime: 20;
    }
}

if time = 1 {
    call CSnd(0, 4, 1);
}

call EndState(0);


# ============================================================================
# ★★★ EX Projectile「双气弹」(EX Ki Blast) —— State 1010 / Anim 1010 ★★★
#
#   236 + C（命令 QCF_y），**耗 500 气**。
#
# 气量的"检查 → 扣除"分工（沿用 P2/P3 约定，本项目唯一写法）：
#   检查在路由层（command.zss：`power >= 500`）
#   扣除在本状态 time = 0 的 powerAdd{value: -500}
#
# 相对 State 1000 的**明确强化点**（合同 §11.3 要求至少两项，这里三项）：
#   ① 到发射 9 → 4 tick（快一倍多）
#   ② 一次 2 发（elem 3 与 elem 5 各一枚，高度差 18 px）
#   ③ 合计伤害 110（普通版 60）
# 代价：气 500 + 总时长 36 tick（收招更长，挥空更亏）。
#
# ★ 这是"EX 必须是真强化"的证据：不是换个 State No 而已 ——
#   生成次数、时机、伤害、速度四项都不同，且 Power 消费可实测。
# ============================================================================
[StateDef 1010;
type: S; movetype: A; physics: S;
juggle: 5; velset: 0, 0; ctrl: 0;
anim: 1010;
poweradd: 0;                      # 出招本身不集气（它要花气）
sprpriority: 2;]

if time = 0 {
    powerAdd{value: -500}         # ★ 气量扣除在这里
    call AtkInit(4);              # lv4（EX / Super 同层，最高链级）
    call ProjInit();
}

# 第 1 发：偏上
if animElem = 3 && var(10) = 0 {
    var(10) := 1;
    projectile{
        projanim: 1005;
        projid: 1001;
        postype: p1;
        offset: 34, -52;
        velocity: 7.5, 0;
        projhits: 1;
        projremovetime: 130;
        projpriority: 2;
        projmisstime: 0;
        projsprpriority: 3;
        projedgebound: 40;
        projstagebound: 40;
        attr: S, SP;
        damage: 55, 5;
        animtype: Medium;
        guardflag: MA;
        hitflag: MAF;
        priority: 5, Hit;
        pausetime: 12, 12;
        sparkno: 1;
        sparkxy: -10, -70;
        hitsound: 5, 1;
        guardsound: 6, 0;
        ground.type: High;
        ground.slidetime: 10;
        ground.hittime: 17;
        ground.velocity: -7;
        airguard.velocity: -2.8, -1.2;
        air.velocity: -3, -4;
        air.hittime: 22;
    }
}

# 第 2 发：偏下 —— 两发高度差 18 px，站防挡住上面那发时下面那发仍会擦到
if animElem = 5 && var(10) = 1 {
    var(10) := 2;
    projectile{
        projanim: 1005;
        projid: 1002;
        postype: p1;
        offset: 34, -28;
        velocity: 7.5, 0;
        projhits: 1;
        projremovetime: 130;
        projpriority: 2;
        projmisstime: 0;
        projsprpriority: 3;
        projedgebound: 40;
        projstagebound: 40;
        attr: S, SP;
        damage: 55, 5;
        animtype: Medium;
        guardflag: MA;
        hitflag: MAF;
        priority: 5, Hit;
        pausetime: 12, 12;
        sparkno: 1;
        sparkxy: -10, -55;
        hitsound: 5, 1;
        guardsound: 6, 0;
        ground.type: High;
        ground.slidetime: 10;
        ground.hittime: 17;
        ground.velocity: -7;
        airguard.velocity: -2.8, -1.2;
        air.velocity: -3, -4;
        air.hittime: 22;
    }
}

if time = 1 {
    call CSnd(0, 4, 1);
}

call EndState(0);


# ============================================================================
# ★★★ Anti-Air Special「升龙上勾拳」(Rising Upper) —— State 1100 / Anim 1100 ★★★
#
#   623 + A（命令 DP_x），**不耗气**。
#
# 定位：**对空反击技**。Zoner 的第二件核心工具 —— 当长手和投射物把对手
#   逼得跳进来时，用它把对手打回去。
#
# ★ 几何（这是"真的能对空"的证据，见 .air 的 Action 1100）：
#     判定框 Clsn1[0] = 28,-60 → 62,-152
#   即：从胸口高度一直到 **y = -152**（角色身高 60 的 2.5 倍），
#   横向覆盖 x 28…62。对手跳入时经过的高度与水平位置都落在里面。
#   与 410（对空 Normal，到 -112）的分工：1100 更高更远、带击倒，但更慢。
#
# ★ 物理上保持 physics: S（角色不离地）—— 靠判定框向上延伸实现对空，
#   这样落地/起身链路完全走原有公共状态，不必额外处理空中物理。
#
# ★ 它不是万能技（合同 §11.2 要求"对地面目标不是万能技"）：
#   起手 12 tick、收招 24 tick —— 对手在地面时不放它就是最好的选择，
#   AI 也只在"对手真的在空中"时才用它（AI.zss ②）。
# ============================================================================
[StateDef 1100;
type: S; movetype: A; physics: S;
juggle: 3; velset: 0, 0; ctrl: 0;
anim: 1100;
poweradd: 35;
sprpriority: 2;]

if time = 0 {
    call AtkInit(3);              # lv3 = 必杀技
}

# 起手时极小的前压（8 px）：避免贴身时判定框完全包住自己
if animElem = 3 {
    posAdd{x: 8}
}

if animElem = 7 {
    var(4) := 1;
    hitDef{
        attr: S, SA;
        damage: 75, 6;
        animtype: Up;
        guardflag: MA;
        hitflag: MAF;
        priority: 5, Hit;
        pausetime: 14, 14;
        sparkno: 3;
        sparkxy: 0, -130;         # 火花位置高 —— 在头顶之上
        hitsound: 5, 4;
        guardsound: 6, 0;
        ground.type: Low;
        ground.slidetime: 22;
        ground.hittime: 24;
        ground.velocity: -1.5, -12;   # 地面命中 → 把对手挑起来
        airguard.velocity: -3, -4;
        air.velocity: -1.5, -12;      # 空中命中 → 直接打飞
        air.hittime: 26;
        yaccel: .55;
        fall: 1;                  # 强制倒地（对空技的标准收尾）
        fall.recover: 1;          # 允许受身（公平性设计）
    }
}

if time = 1 {
    call CSnd(0, 2, 1);
}

call EndState(0);


# ============================================================================
# ★★★ Super「气弹炮」(Ki Blast Cannon) —— State 3000 / Anim 3000 ★★★
#
#   236236 + A（命令 QCF2_x），**耗 1000 气**（气槽上限 2000）。
#
# 设计思路：Zoner 的 Super 不应该是"一记更大的拳"，而应该是
# **把投射物做成弹幕** —— 一次 3 发，三发高度不同、各自独立飞行与判定。
# 这样对手不能靠"一次防御"或"一次跳跃"躲掉全部，Super 才有"改变局面"的意义。
#
# 相对 EX（1010）的强化：
#   数量 2 → 3、总伤害 110 → 195（每发 65）、速度 7.5 → 8、气耗 500 → 1000
#
# 刻意**不做**（属 P7 表现层，合同 §11.4 明确排除）：
#   superPause 定格、镜头推进、闪光、暗转、正式演出。
#
# 帧序（.air 的 Action 3000）：到第一发 9 tick / 总 44 tick
#                                发射帧 = elem 4（t=9）/ elem 7（t=18）/ elem 9（t=26）
# ============================================================================
[StateDef 3000;
type: S; movetype: A; physics: S;
juggle: 6; velset: 0, 0; ctrl: 0;
anim: 3000;
poweradd: 0;                      # 出招本身不集气（它要花气）
sprpriority: 2;]

if time = 0 {
    powerAdd{value: -1000}        # ★ 气量扣除（Super 的代价）
    call AtkInit(4);              # lv4
    call ProjInit();
}

