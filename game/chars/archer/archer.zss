# ============================================================================
# ★ 2026-11-08 方向变体：← 退重斩 —— StateDef 265
#   后撤 · 重斩 / 不耗气 / lv2（可接在普通技之后，也可继续接气键技能）
#   ★ 2026-11-09 换成全新动作：SFF 组 2650（源包 action 3050 持大刀挥斩）
#   位移只在起手前 3 tick（约 6 px），判定帧时已停住
# ============================================================================
# ★ 2026-11-11 重做：←+S 空中斜下射箭 —— StateDef 265
#   跳起到半空 → 拉弓 → 向自己的斜下方射出一支**真箭**（projectile）。
#   ★ 负责人反馈：这招原本是近战大刀挥斩，与「跳起拉弓射箭」的预期不符。
#   现在本体没有 hitDef / Clsn1，伤害全部在箭上。
#   动画：SFF 组 2650（源包 action 1000 拉弓 14 帧，含放箭与收招）。
#   不耗气 / lv2 / 31 tick；箭可被走位或跳跃躲开，不是必中。
# ============================================================================
[StateDef 265;
type: A; movetype: A; physics: A;
juggle: 2; velset: 0, 0; ctrl: 0;
anim: 265;
poweradd: 15;
sprpriority: 2;]

# ★ 起跳初速只在起手段写；之后交给 physics: A 的重力，角色自然升到顶点再落下。
#   （状态级 velSet 每 tick 都会写回，必须用 if time < 分段，不能写在 time = 0 里。）
if time < 8 {
    velSet{x: -2; y: -7}
}

if time = 0 {
    call AtkInit(2);
    call ProjInit();
}

# 拉满弓那一 tick 的弓弦光效
if time = 16 {
    explod{
        anim: 7250; ID: 8105;
        postype: p1; pos: 55, -95;
        scale: 0.22, 0.22;
        bindtime: -1; removetime: -2;
        ownpal: 1; sprpriority: 3; removeongethit: 1;
    }
}

# ★ 第 9 个动画元素（拉满弓）放箭。
#   animElem = N 在整个元素持续期内都为真 —— 没有 var(10) 闩锁会连发多支箭。
if animElem = 9 && var(10) = 0 {
    var(10) := 1;
    projectile{
        projanim: 1005;
        projid: 2650;
        postype: p1;
        offset: 70, -110;
        velocity: 8, 6;          # 斜下：比地面版 ↓C 的 7,3 更陡
        projhits: 1;
        projremovetime: 90;
        projpriority: 3;
        projmisstime: 0;
        projsprpriority: 3;
        projedgebound: 40;
        projstagebound: 40;
        attr: S, SP;
        damage: 55, 10;
        animtype: Hard;
        guardflag: MA;
        hitflag: MAF;
        priority: 4, Hit;
        pausetime: 12, 12;
        sparkno: S7190;
        guard.sparkno: S7191;
        sparkxy: 0, 0;
        hitsound: 9000, 0;
        guardsound: 9000, 1;
        ground.type: High;
        ground.slidetime: 10;
        ground.hittime: 18;
        ground.velocity: -3;
        airguard.velocity: -3, -1.3;
        air.velocity: -3, -4;
        air.hittime: 20;
    }
}

if time = 1 {
    call CSnd(9000, 0, 1);
}

call EndState(0);


