# ============================================================================
# ★ P6 新操作体系：后撤投剑 —— StateDef 1200
#   ←C —— 拉开距离的同时投出剑，中距离 / 拉开
#   消耗 400 气 | lv3 | 伤害 65
# ============================================================================
[StateDef 1200;
type: S; movetype: A; physics: S;
juggle: 3; velset: 0, 0; ctrl: 0;
anim: 1200;
poweradd: 0;
sprpriority: 2;]

# Art pass: non-interactive visual accents.
if time = 0 {
    explod{
        anim: 7240; ID: 7240;
        postype: p1; pos: 0, -70;
        scale: 0.3, 0.3;
        bindtime: -1; removetime: -2;
        ownpal: 1; sprpriority: 3; removeongethit: 1;
    }
}
if time = 12 {
    explod{
        anim: 7240; ID: 7240;
        postype: p1; pos: 40, -75;
        scale: 0.21, 0.21;
        bindtime: -1; removetime: -2;
        ownpal: 1; sprpriority: 3; removeongethit: 1;
    }
}


# ★ 后撤：起手 12 tick 向后跳开，判定帧起停住。
#   这一招原本**完全没有位移**（换完美术之后只剩一个原地扔剑的动作），
#   与"后撤投剑"这个名字和用法（被逼近时拉开 + 反制）对不上。
#   位移量 6.5 × 12 ≈ 78 px，约一个身位。
if time < 12 {
    velSet{x: -6.5}
}
if time >= 12 {
    velSet{x: 0}
}

if time = 0 {
    powerAdd{value: -400}
    call AtkInit(3);
    call ProjInit();
}

if animElem = 7 {          # ★ P6 对齐：AIR 重排后首个判定元素是第 7 帧（原写 4）
    var(10) := 1;
    projectile{
        projanim: 1205;
        projid: 1200;
        postype: p1;
        offset: 40, -90;
        # ★ 2026-10-31 修：原来写 `velocity: -6, 0`，剑出来后是**朝身后**飞的，
        #   人往前压也永远吃不到这一剑 —— 端到端验收里 1200 的伤害恒为 0
        #   （runtime 实测：state 1200 全程 p2 生命不动，而 56 点伤害声明在案）。
        #   投掷物的 velocity 是**绝对坐标**（不像 offset / pos 那样跟随朝向），
        #   所以朝对手飞必须是正数。同族的 1000/1150/3000 都是正 velocity。
        velocity: 6, 0;
        projhits: 1;
        projremovetime: 90;
        projpriority: 2;
        projsprpriority: 3;
        projedgebound: 40;
        projstagebound: 40;
        attr: S, SP;
        damage: 56, 8;
        animtype: Hard;
        guardflag: MA;
        hitflag: MAF;
        priority: 4, Hit;
        pausetime: 10, 10;
        sparkno: S7190;
        guard.sparkno: S7191;
        sparkxy: 0, 0;
        hitsound: 9000, 0;      # [P6] 原 5,x 是 KFM 编号，kuri 库里不存在
        guardsound: 9000, 1;    # [P6] 原 6,0 是 KFM 编号，kuri 库里不存在
        ground.type: High;
        ground.slidetime: 12;
        ground.hittime: 18;
        ground.velocity: -4;
        airguard.velocity: -3, -1.3;
        air.velocity: -3, -4;
        air.hittime: 20;
    }
}

if time = 1 {
    call CSnd(9000, 1, 1);
}

call EndState(0);


# ============================================================================
# ★ P6 新操作体系：突进斩 —— StateDef 1300
#   →D —— 突进接近，中距离 / 突进 / 破防
#   消耗 600 气 | lv3 | 伤害 85
# ============================================================================
[StateDef 1300;
type: S; movetype: A; physics: S;
juggle: 3; velset: 0, 0; ctrl: 0;
anim: 1300;
poweradd: 0;
sprpriority: 2;]

# Art pass: non-interactive visual accents.
if time = 0 {
    explod{
        anim: 7270; ID: 7270;
        postype: p1; pos: -15, 0;
        scale: 0.4, 0.4;
        bindtime: 0; removetime: -2;
        ownpal: 1; sprpriority: 3; removeongethit: 1;
    }
}
if time = 12 {
    explod{
        anim: 7260; ID: 7260;
        postype: p1; pos: 0, 0;
        scale: 0.48, 0.48;
        bindtime: -1; removetime: -2;
        ownpal: 1; sprpriority: 3; removeongethit: 1;
    }
}


# ★ 突进：只在**起手段**（前 12 tick）推进，判定帧一开始就停住。
#   原来是写在 `if time = 0` 里的 `velSet{x: 7.5}` —— 只生效一帧，
#   靠站立摩擦 0.85 自然衰减，实测只滑出约 38 px，等于"突进不突进"。
#   分段的理由同闪身：状态级写法必须配 `time >=` 才能真的停住。
if time < 12 {
    velSet{x: 7.5}
}
if time >= 12 {
    velSet{x: 0}      # 判定帧起停住：位移不再变，收招 14 tick 可被确反
}

if time = 0 {
    powerAdd{value: -600}
    call AtkInit(3);
}

if animElem = 7 {          # ★ P6 对齐：AIR 重排后首个判定元素是第 7 帧（原写 6）
    var(4) := 1;
    hitDef{
        attr: S, SA;
        damage: 78, 12;
        animtype: Hard;
        guardflag: MA;
        hitflag: MAF;
        priority: 5, Hit;
        pausetime: 12, 12;
        sparkno: S7190;
        guard.sparkno: S7191;
        sparkxy: 0, -90;
        hitsound: 9000, 0;      # [P6] 原 5,x 是 KFM 编号，kuri 库里不存在
        guardsound: 9000, 1;    # [P6] 原 6,0 是 KFM 编号，kuri 库里不存在
        ground.type: Low;
        ground.slidetime: 20;
        ground.hittime: 22;
        ground.velocity: -6;
        airguard.velocity: -3, -3;
        air.velocity: -3, -8;
        air.hittime: 24;
        fall: 1;
        fall.recover: 1;
    }
}

if time = 1 {
    call CSnd(9000, 3, 1);
}

call EndState(0);


# ============================================================================
# ★ P6 新操作体系：跳劈下压 —— StateDef 1400
#   ↓D —— 压制起手，近身 / 破防
#   消耗 600 气 | lv3 | 伤害 90
# ============================================================================
[StateDef 1400;
type: S; movetype: A; physics: S;
juggle: 3; velset: 0, 0; ctrl: 0;
anim: 1400;
poweradd: 0;
sprpriority: 2;]

# Art pass: non-interactive visual accents.
if time = 12 {
    explod{
        anim: 7230; ID: 7230;
        postype: p1; pos: 0, 0;
        scale: 0.48, 0.48;
        bindtime: -1; removetime: -2;
        ownpal: 1; sprpriority: 3; removeongethit: 1;
    }
}


if time = 0 {
    powerAdd{value: -600}
    call AtkInit(3);
}

if animElem = 7 {          # ★ P6 对齐：AIR 重排后首个判定元素是第 7 帧（原写 6）
    var(4) := 1;
    hitDef{
        attr: S, SA;
        damage: 84, 12;
        animtype: Up;
        guardflag: H;             # ★ Overhead：只能站防（蹲防防不住）
                                  #   原来写 MA = 上下都能防，与出招表「破防（overhead）」、
                                  #   AI 规则 ⑤c 的「制造必须站防的局面」全都对不上 → 那两处承诺是空的。
        hitflag: MAF;
        priority: 5, Hit;
        pausetime: 12, 12;
        sparkno: S7190;
        guard.sparkno: S7191;
        sparkxy: 0, -90;
        hitsound: 9000, 0;      # [P6] 原 5,x 是 KFM 编号，kuri 库里不存在
        guardsound: 9000, 1;    # [P6] 原 6,0 是 KFM 编号，kuri 库里不存在
        ground.type: Low;
        ground.slidetime: 20;
        ground.hittime: 22;
        ground.velocity: -2;
        airguard.velocity: -3, -3;
        air.velocity: -3, -8;
        air.hittime: 24;
        fall: 1;
        fall.recover: 1;
    }
}

if time = 1 {
    call CSnd(9000, 5, 1);
}

call EndState(0);


# ============================================================================
# ★ 新增「闪身」：前冲闪 —— StateDef 110
#   → 快速接近对手，同时无敌穿过箭矢（破解弓箭压制）
#   输入 A+Z（轻拳 + 轻脚同时，KOF97 的 A+B 闪身）；**不耗气**
#   前 2 帧无受击框（无敌），其后恢复受击框 → 甩空会被惩罚
# ============================================================================
[StateDef 110;
type: S; physics: S;
anim: 110;
ctrl: 0;
sprpriority: 2;]

# Art pass: non-interactive visual accents.
if time = 0 {
    explod{
        anim: 7270; ID: 7270;
        postype: p1; pos: -15, 0;
        scale: 0.4, 0.4;
        bindtime: 0; removetime: -2;
        ownpal: 1; sprpriority: 3; removeongethit: 1;
    }
}


# ★ 位移必须写在状态级（每 tick 执行），但**只写状态级还不够**：
#   状态级每 tick 都会把速度重新写成 11，`if time = 12` 里置的 0 在下一 tick 就被覆盖，
#   结果收招 8 tick 仍在往前滑 —— 等于「可被惩罚的窗口」不存在。
#   所以按 time 分段，让「停住」也是每 tick 都成立的状态。
#   （历史：最初写在 `if time = 0` 里 = 只生效一帧，人物根本不动。）
if time < 12 {
    velSet{x: 11}
}

if time >= 12 {
    velSet{x: 0}       # 第 12 tick 起停住 → 其后 8 tick 是可被惩罚的收招
}

if time = 0 {
    call CSnd(9000, 3, 1);
}

if time = 19 {
    changeState{value: 0; ctrl: 1}
}


# ============================================================================
# ★ 新增「闪身」：后撤闪 —— StateDef 115
#   ← 拉开距离，同时无敌（被逼近时的脱身）
#   输入 A+Z（轻拳 + 轻脚同时，KOF97 的 A+B 闪身）；**不耗气**
#   前 2 帧无受击框（无敌），其后恢复受击框 → 甩空会被惩罚
# ============================================================================
[StateDef 115;
type: S; physics: S;
anim: 115;
ctrl: 0;
sprpriority: 2;]

# Art pass: non-interactive visual accents.
if time = 0 {
    explod{
        anim: 7270; ID: 7270;
        postype: p1; pos: 15, 0;
        scale: 0.4, 0.4;
        bindtime: 0; removetime: -2;
        ownpal: 1; sprpriority: 3; removeongethit: 1;
    }
}


# ★ 同 110：状态级 velSet 每 tick 生效，必须按 time 分段才能真的停住
if time < 12 {
    velSet{x: -10}
}

if time >= 12 {
    velSet{x: 0}       # 第 12 tick 起停住 → 其后 8 tick 是可被惩罚的收招
}

if time = 0 {
    call CSnd(9000, 3, 1);
}

if time = 19 {
    changeState{value: 0; ctrl: 1}
}


# ============================================================================
# ★ 新增「闪身」：下闪 —— StateDef 117
#   ↓ 蹲身闪避，躲过中段攻击（被围时的近距离脱身）
#   输入 A+Z（轻拳 + 轻脚同时，KOF97 的 A+B 闪身）；**不耗气**
#   前 2 帧无受击框（无敌），其后恢复受击框 → 甩空会被惩罚
# ============================================================================
[StateDef 117;
type: S; physics: S;
anim: 117;
ctrl: 0;
sprpriority: 2;]

# 下闪是原地低身，**不位移**：状态级持续把速度钉在 0，防止继承上一状态的残余速度
velSet{x: 0}
if time = 0 {
    call CSnd(9000, 3, 1);
}

if time = 12 {
    velSet{x: 0}       # 第 12 tick 停住 → 其后 8 tick 是可被惩罚的收招
}

if time = 19 {
    changeState{value: 0; ctrl: 1}
}

# ============================================================================
# [StateDef -3] —— 每 tick 执行，且只在角色自己的状态文件内生效
# （与 -1 的区别见架构文档 §4.3）。与模板一样保持为空 ——
# 不为了"看起来完整"塞无意义内容。
# ============================================================================
[StateDef -3]
