# ============================================================================
# ★ 可选技术层 T1「同键二次」—— State 250 / 251 / 252 / 253
#
#   输入：同一个普通键按两次（.cmd 的 TAP_* 窗口 36 tick；见 archer.cmd 里的说明）。
#   输出：该招的**二段**——同一套动画，伤害与硬直都更轻，但它是 **lv4**。
#
# ★ 为什么二段是 lv4（而不是 lv2）：
#   取消链的规则是"等级严格递增"。把二段放在最高级，等于说
#   **「二段是连段的句号」**——它可以从任何普通技接进来（4 > 1/2/3），
#   接进来之后再也不能取消成别的招。这既给了连段一条明确的收尾，
#   也从结构上杜绝了「A A A A…」这种无限连（lv 只增不减）。
#
# ★ 为什么二段只能用普通技接（var(3) <= 2）：
#   允许从必杀技（lv3）接回一个普通技会破坏等级语义（大招后接普攻），
#   也会让"读招失败"没有代价。条件写在 command.zss 的 CanTap() 里。
#
# ★ 复用动画、不新增美术：二段与一段共用同一段动作，判定落在同一个
#   animElem 上；变的只有伤害、硬直与"能不能再取消"。
# ============================================================================

# --- T1 二段：轻斩 ---
[StateDef 250;
type: S; movetype: A; physics: S;
juggle: 0; velset: 0, 0; ctrl: 0;
anim: 200;
poweradd: 10;
sprpriority: 2;]

if time = 5 {
    explod{
        anim: 7200; ID: 7200;
        postype: p1; pos: 0, 0;
        scale: 0.48, 0.48;
        bindtime: -1; removetime: -2;
        ownpal: 1; sprpriority: 3; removeongethit: 1;
    }
}

if time = 0 {
    call AtkInit(4);          # lv4 = 连段收尾，不可再取消
}

if animElem = 6 {
    var(4) := 1;
    hitDef{
        attr: S, NA;
        damage: 20, 6;
        animtype: Light;
        guardflag: MA;
        hitflag: MAF;
        priority: 3, Hit;
        pausetime: 6, 6;
        sparkno: S7190;
        guard.sparkno: S7191;
        sparkxy: -10, -76;
        hitsound: 9000, 0;
        guardsound: 9000, 1;
        ground.type: High;
        ground.slidetime: 4;
        ground.hittime: 13;
        ground.velocity: -3;
        airguard.velocity: -1.9, -.8;
        air.type: High;
        air.velocity: -1.4, -3;
        air.hittime: 15;
    }
}

if time = 1 {
    call CSnd(9000, 4, 1);
}

call EndState(0);


