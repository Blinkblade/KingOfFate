# ============================================================================
# 蹲轻拳 A（Crouching Light Punch）—— State 400   lv1，下段
# 下段、快、轻。type: C 是必须的（否则站防能挡住）。
# ============================================================================
# ============================================================================
# ★ 2026-11-08 方向变体：→ 冲斩 —— StateDef 260
#   刀刃 · 短突进 / 不耗气 / lv2（可接在普通技之后，也可继续接气键技能）
#   ★ 2026-11-09 换成全新动作：SFF 组 2600（源包 action 205 拔刀横斩）
#   位移只在起手前 5 tick（约 27 px），判定帧时已停住
# ============================================================================
[StateDef 260;
type: S; movetype: A; physics: S;
juggle: 2; velset: 0, 0; ctrl: 0;
anim: 260;
poweradd: 15;
sprpriority: 2;]

if time < 5 {
    velSet{x: 5.5}
}
if time >= 5 {
    velSet{x: 0}
}


# ★ 2026-11-11 打击感：命中帧的刀光/冲击特效（只在这一 tick 放一次）。
if time = 5 {
    explod{
        anim: 7260; ID: 8100;
        postype: p1; pos: 12, -70;
        scale: 0.42, 0.42;
        bindtime: -1; removetime: -2;
        ownpal: 1; sprpriority: 3; removeongethit: 1;
    }
}
if time = 0 {
    call AtkInit(2);
}

if animElem = 4 {
    var(4) := 1;
    hitDef{
        attr: S, NA;
        damage: 30, 6;
        animtype: Light;
        guardflag: MA;
        hitflag: MAF;
        priority: 4, Hit;
        pausetime: 14, 14;
        sparkno: S7190;
        guard.sparkno: S7191;
        sparkxy: -10, -76;
        hitsound: 9000, 0;
        guardsound: 9000, 1;
        ground.type: High;
        ground.slidetime: 5;
        ground.hittime: 18;
        ground.velocity: -3;
        airguard.velocity: -1.9, -.8;
        air.type: High;
        air.velocity: -1.4, -3;
        air.hittime: 15;
    }
}

call EndState(0);

