# ============================================================================
# ★★★ 蹲重拳 C（Crouching Heavy Punch）—— **对空 Normal（Anti-Air Normal）** ★★★
#
# 几何：判定框向上抬到 **y = -112**（Fighter A 同位置是 -94），x 26→58。
#       .air 的 Action 410 把它画成一条从腰到头顶的斜柱。
#   含义：对手跳入时身体大致落在 y = -60 … -110 这一段，本判定框正覆盖它。
#
# 代价（合同 §10.2 要求"可靠但有 Recovery 风险"）：
#   起手 8 tick、收招 14 tick —— 挥空后有一段完全不能动。
#
# ★ 它对地面目标**不是万能技**：判定框集中在高处，贴地/低姿目标不在范围内 ——
#   Gate 4 实测了"地面目标打不到、空中目标打得到"这个几何事实。
# ============================================================================
[StateDef 410;
type: C; movetype: A; physics: C;
juggle: 4; velset: 0, 0; ctrl: 0;
anim: 410;
poweradd: 25;
sprpriority: 2;]

# Art pass: non-interactive visual accents.
if time = 9 {
    explod{
        anim: 7220; ID: 7220;
        postype: p1; pos: 0, 0;
        scale: 0.42, 0.42;
        bindtime: -1; removetime: -2;
        ownpal: 1; sprpriority: 3; removeongethit: 1;
    }
}


if time = 0 {
    call AtkInit(2);
}

if animElem = 4 {          # ★ P6 对齐：AIR 重排后首个判定元素是第 4 帧（原写 3）
    var(4) := 1;
    hitDef{
        attr: C, NA;
        damage: 50, 8;
        animtype: Up;             # 向上打飞
        guardflag: MA;
        hitflag: MAF;
        priority: 4, Hit;
        pausetime: 12, 12;
        sparkno: S7190;
        guard.sparkno: S7191;
        sparkxy: -10, -95;        # 火花在头顶
        hitsound: 9000, 0;      # [P6] 原 5,x 是 KFM 编号，kuri 库里不存在
        guardsound: 9000, 1;    # [P6] 原 6,0 是 KFM 编号，kuri 库里不存在
        ground.type: High;
        ground.slidetime: 10;
        ground.hittime: 20;
        ground.velocity: -3, -6;  # 对空命中会把对手顶起来
        airguard.velocity: -2.6, -1.1;
        air.type: High;
        air.velocity: -2.2, -5;
        air.hittime: 22;
        yaccel: .5;
    }
}

if time = 1 {
    call CSnd(9000, 3, 1);
}

call EndState(1);


