# ============================================================================
# ★ P6：无限剑制（Unlimited Blade Works）—— StateDef 3100
#
# 简化版（P6 范围，完整结界演出留给 P7）：咏唱起手 → 剑雨。
#   费用 2000 气（= 整条气槽），lv4。
#   伤害全部在剑的投射物上（Action 3105）；本体动作没有 Clsn1。
#   剑以**对手**为基准生成（postype: p2），从上方落下 —— 这才是"剑雨"。
#      10 把 × 80 = 上限 800；实测常见 4~6 连 ⇒ 320~480（32%~48% 血）。
#
# ★ 2026-11-03 第二次：单把 16 → 50。
#   原来的问题不是"数字小"，是**结构倒挂**：
#       Super（3000）花 1000 气得 195；
#       终极（3100）花 2000 气（整条槽）只有 10 × 16 = 160 上限、实测 96。
#   花两倍的气打出四分之一的伤害 —— 那不是"大招"，是惩罚。
# ★ 2026-11-08 第三次（负责人试玩反馈）：单把 50 → 80，剑的击退 -2 → -1、
#   hittime 18 → 20。原因：50 × 6 连 = 300 只在"对手站着不动"时成立，
#   实机里对手会走位/被前一把剑推开，常常只吃到 2~3 把 = 100~150，
#   体感完全不像整槽大招。改成 80 之后 **连到 4 把就 320 ≥ 30% 血**，
#   这是"一次至少打掉 30%"的保底，不是最好情况。
#   减小击退 / 加长硬直是为了让后续剑更容易连上（剑落点是固定的，
#   对手被推太远就会漏）。

[StateDef 3100;
type: S; movetype: A; physics: S;
juggle: 10; velset: 0, 0; ctrl: 0;
anim: 3100;
poweradd: 0;                      # 出招不集气（它要花光整槽）
sprpriority: 2;]

# ★ 2026-11-03：剑雨**不可防御**。
#   依据（引擎源码，不是猜）：char.go:10844 的
#       canguard := !c.asf(ASF_unguardable) && getter.scf(SCF_guard) && ...
#   这里的 `c` 是**攻方**，所以攻方身上带 unguardable 时，对手的防御一律不成立；
#   紧邻的注释原文写着 "Unguardable flag also affects projectiles"（issue #2367），
#   所以这一条对 3100 发出的投射物同样有效 —— 不需要改 guardflag。
#   必须是**状态级**：只在某一 tick 写一次的话，下一 tick 就失效了。
#   状态总长 198 tick ≥ 最后一把剑的 110 tick 存活期，覆盖整场剑雨。
#   代价：2000 气 + 长咏唱，换一发不可防、保底 320（4 连）的伤害；
#   可被走位/跳跃躲开，不是必胜。
assertSpecial{ flag: unguardable }

# Art pass: non-interactive visual accents.
if time = 0 {
    explod{
        anim: 7240; ID: 7240;
        postype: p1; pos: 0, -70;
        scale: 0.4, 0.4;
        bindtime: -1; removetime: -2;
        ownpal: 1; sprpriority: 3; removeongethit: 1;
    }
}
if time = 18 {
    explod{
        anim: 7240; ID: 7240;
        postype: p1; pos: 0, -70;
        scale: 0.4, 0.4;
        bindtime: -1; removetime: -2;
        ownpal: 1; sprpriority: 3; removeongethit: 1;
    }
}
if time = 0 {
    explod{
        anim: 7280; ID: 7280;
        postype: p1; pos: 0, 0;
        scale: 0.6, 0.18;
        bindtime: -1; removetime: 36;
        ownpal: 1; sprpriority: -1; removeongethit: 1;
    }
}


if time = 0 {
    powerAdd{value: -2000}        # ★ 整槽气（2000）
    call AtkInit(4);              # lv4
