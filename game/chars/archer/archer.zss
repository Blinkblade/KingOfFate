        damage: 64, 10;
        animtype: Heavy;
        guardflag: MA;
        hitflag: MAF;
        priority: 4, Hit;
        pausetime: 13, 13;
        sparkno: S7190;
        guard.sparkno: S7191;
        sparkxy: -10, -66;
        hitsound: 9000, 0;      # [P6] 原 5,x 是 KFM 编号，kuri 库里不存在
        guardsound: 9000, 1;    # [P6] 原 6,0 是 KFM 编号，kuri 库里不存在
        ground.type: High;
        ground.slidetime: 10;
        ground.hittime: 20;
        ground.velocity: -7;
        airguard.velocity: -2.8, -1.2;
