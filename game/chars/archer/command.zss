# ============================================================================
# KingOfFate — Test Fighter B（P4，Zoner）：命令路由（command.zss）
#
# 本文件回答唯一一个问题：**哪个命令进入哪个状态**。
#
# ★★★ 最重要的一条规则（P1 实验 E5 直接验证）★★★
#   [StateDef -1] 从上到下逐条判断，**先命中者生效，后面的全部跳过**。
#   因此：条件更"窄"的规则必须写在更"宽"的规则前面。
#
#   KFM 源码里也写着同一句话：
#   "State entry with a certain command must come before another
#    state entry with a command that is the subset of the first."
#
# 本角色的实际顺序（改顺序 = 改优先级，必须重跑 Runtime 验证）：
#   ① EX Projectile  （QCF_y，需 500 气）      ← 最窄：多了资源条件
#   ② Super          （QCF2_x，需 1000 气）    ← 窄：资源条件 + 最长指令
#   ③ Projectile     （QCF_x）                 ← 236 系主力
#   ④ Anti-Air       （DP_x）                  ← 623 系，与 236 互不包含
#   ⑤ 投技           （贴身 + 前/后 + C/D）    ← 比单按 C/D 窄，必须在其前面
#   ⑥ 前冲 / 后跳    （FF / BB）
#   ⑦ 蹲普通技       （下 + A/B/C/D）
#   ⑧ 空中普通技     （空中 + A/B/C/D）
#   ⑨ 站立普通技     （A/B/C/D）
#   ⑩ 嘲讽           （start）
#
# ★ 本角色与 Fighter A 的顺序表**结构相同、内容不同**：
#   Fighter A 的 ③④ 是两个近身必杀（突进直拳 / 升龙踢）；
#   Fighter B 的 ③④ 是投射物与防空洞 —— 一个是"远"，一个是"高"。
#   这正是同一个框架支撑两种战斗风格的地方（P4 要回答的问题 1）。
#
# ★★★ 普攻取消链（T7）—— 沿用 P3 的等级系统，**没有新建第二套** ★★★
#
#   每个攻击状态在自己的 time = 0 调 AtkInit(lv) 登记链等级 var(3)，
#   并在**首个判定帧**把 var(4) 置 1（= 取消窗口开启）。放行时要求
#   目标等级**严格大于**当前等级：
#
#       lv1 轻普通技  200 / 230 / 400 / 430 / 600 / 630
#         ↓  (轻 → 重)
#       lv2 重普通技  210 / 240 / 410 / 440 / 610 / 640
#         ↓  (普通 → 必杀)
#       lv3 必杀技    1000（投射物） / 1100（对空）
#         ↓  (必杀 → EX / Super)
#       lv4 EX·Super  1010 / 3000
#
#   为什么用"等级递增"而不是"能不能取消"的布尔量：
#     * 等级只增不减 → 连段长度天然有上限（最长 4 段），**不可能无限循环**
#     * 条件恒定、可读，不需要为每对招式单独写条件
#
#   ★ 本角色要验证的取消路径（合同 §12）：
#       Normal → Special   ：200(A) → 1000(投射物)
#       Special → Super    ：1000 → 3000
#       Normal → EX        ：210(C) → 1010
#
# ★ 空中普通技不参与取消链：CanChain 的自由分支要求 `stateType != A`。
#
# 依据：docs/ikemen_character_architecture.md §4.3 / §5.3
# 实测对照：game/chars/test_fighter_a/command.zss
# ============================================================================


# ============================================================================
# 工具函数：链等级放行判定（沿用 P3 的 CanChain，未修改语义）
#
# $canChain = 1 表示"现在允许进入等级 lv 的招式"。两种进入方式：
#   a) 完全自由：在地面且有控制权（stateType != A && ctrl）
#   b) 取消（Cancel）：正处于某个攻击状态，且
#        - 该状态的判定帧已经开始（var(4) = 1）
#        - 本次攻击还没取消过（var(0) = 0）
#        - 目标等级更高（var(3) < lv）—— 这是防无限连段的关键
#
# ★ 语法坑（P2 实测踩到）：`animElem` 裸触发器只支持 = / !=。
#   本文件因此不使用 animElem 裸比较，改用状态自己维护的 var(4)。
# ============================================================================
[Function CanChain(lv) ret]
let ret = 0;
# a) 自由状态（地面 + 有控制权）—— 空中放行会切进地面招，故排除
if stateType != A && ctrl {
    let ret = 1;
}
# b) 取消：等级严格递增 + 判定帧已开始 + 本次攻击尚未取消
#    ★ 2026-10-31 补：必须确认"我**正在出招**"（moveType = A）且不处于空中。
#      原来没有这条 —— var(3)/var(4) 在离开攻击状态后**不会清零**（EndState 不清），
#      于是被击中（受击硬直）时 var(3) 还是上一招的等级、var(4) 还是 1，
#      玩家连打气键就能从受击硬直里 changeState 出来 = 无代价脱身。
if moveType = A && stateType != A && var(3) > 0 && var(3) < $lv && var(4) = 1 && var(0) = 0 {
    let ret = 1;
}


# ============================================================================
# T1「同键二次」放行判定
#   两种进入方式：
#     a) 自由状态（地面 + ctrl）—— 从站立直接连按两次
#     b) 取消：**普通技**（lv1/lv2）的判定帧已经开始，且本次攻击还没取消过
#   ★ 刻意不允许从必杀技（lv3）接回二段：那会破坏等级语义，
#     也让"读招失败"没有代价。二段自己登记的是 lv4，接进来就再也取消不出去。
# ============================================================================
[Function CanTap() ret]
let ret = 0;
# ★ 只对**站立**普通技成立：蹲着连按两次仍然是蹲招，不会跳成站招
if stateType = S && ctrl {
    let ret = 1;
}
if stateType = S && moveType = A && var(3) >= 1 && var(3) <= 2 && var(4) = 1 && var(0) = 0 {
    let ret = 1;
}


# ============================================================================
# T3「前摇取消」放行判定
#   只在**普通技的起手段**成立：判定帧还没开始（var(4) = 0），
#   且已经演了至少 2 tick（time >= 2）—— 不允许"按了 A 立刻变 C"，
#   那样普通技就等于一个免费缓冲，等于没有前摇。
#   费用的扣除在路由里做（powerAdd -100），和技能本身的耗气分开记。
# ============================================================================
[Function CanCancelStartup() ret]
let ret = 0;
if moveType = A && stateType != A && var(3) >= 1 && var(3) <= 2 && var(4) = 0 && var(0) = 0 && time >= 2 {
    let ret = 1;
}


# ============================================================================
# [StateDef -1] —— 特殊状态：无论当前在哪个状态，每 tick 都执行一次。
# ============================================================================
[StateDef -1]

# 只在战斗进行中处理命令（roundState = 2），且该角色由玩家操作（!aiLevelF）
if roundState = 2 && !aiLevelF {

    # map("canCombo") 与 P2/P3 同义：当前能否出必杀技（= 等级 3 是否放行）。
    # 只读快照，禁止在状态里改它。
    #
    # ★ 语法坑（P3 实测踩到）：`call` **不能内联写在 if 条件里**，
    #   必须先 let 取出来再引用 $变量。
    let canCombo = call CanChain(3);
    let canLv4 = call CanChain(4);
    let canLv3 = call CanChain(3);
    let canLv2 = call CanChain(2);
    let canLv1 = call CanChain(1);
    let canTap = call CanTap();
    let canStartup = call CanCancelStartup();
    ignoreHitPause{mapSet{map:"canCombo"; value: $canCombo}}

    # ========================================================================
    # 【T2 完美防】格挡成立的那一 tick，若"后"是在 3 tick 内按下去的 → 精防
    #   奖励：+80 气 + 格挡环特效。
    #
    # ★ 为什么奖励只有气，没有改硬直/推退：
    #   格挡硬直与推退由公共状态 150/152/154 接管（它们状态级 `velset: 0,0`），
    #   在角色脚本里硬改就等于"重新实现公共状态"，违背 P1 的约定。
    #   气是这游戏唯一的资源，+80 气已经等价于"多打半发箭"。
    #
    # ★ 为什么不用 `moveguarded`：引擎里它是**攻击方**的触发器
    #   （char.go: moveGuarded() 返回 MC_Guarded 的剩余时长），防守方恒为 0。
    #   防守方唯一可靠的判据是「进入了格挡震动状态 150 / 152 / 154」。
    #
    # ★ var(20) 的语义：精防窗口倒计时（3 → 0）。
    #   var(21)：后方向"已经按着"的边沿标记（防止按住后每 tick 重新装填）。
    #   var(22)：本次格挡已经结算过（防止一次格挡反复加分）。
    # ========================================================================
    if var(20) > 0 {
        var(20) := var(20) - 1;
    }
    if command = "holdback" && var(21) = 0 {
        var(21) := 1;
        var(20) := 3;
    }
    if command != "holdback" && var(21) = 1 {
        var(21) := 0;
    }

    if stateNo = 150 || stateNo = 152 || stateNo = 154 {
        if var(22) = 0 {
            var(22) := 1;
            if var(20) > 0 {
                var(20) := 0;
                powerAdd{value: 80}
                explod{
                    anim: 7191; ID: 7191;
                    postype: p1; pos: 0, -70;
                    scale: 0.48, 0.48;
                    bindtime: -1; removetime: -2;
                    ownpal: 1; sprpriority: 3; removeongethit: 1;
                }
            }
        }
    } else {
        var(22) := 0;
    }

    # ========================================================================
    # 【① EX Projectile】236 + C，消耗 500 气
    # 气量检查在这里（路由层），扣气在 test_fighter_b.zss 的 State 1010 里。
    # lv4：可以从自由态起手，也可以从 lv1/lv2 普通技或 lv3 必杀取消进来。
    # ========================================================================
    # ========================================================================
    # 【① 终极技】C + D 同按，消耗 2000 气（整条气槽）
    #   ★ 必须排在最前面：它比"单独 C / 单独 D"更窄，写反了就永远轮不到
    #   ★ 不支持前摇取消：2000 + 100 手续费 = 2100 > 气槽上限 2000
    # ========================================================================
    if command = "GAS_CZ" && power >= 2000 && $canLv4 {
        changeState{value: 3100}
    }

    # ========================================================================
    # 【② 大型技能】D 系（键盘 D = 按钮 z），消耗 600~800 气
    #   →D 突进 / ↓D 压制 / D 中立终结。方向表达**意图**（总纲 §3.4）
    #
    #   ★ T3「前摇取消」：普通技**还没出判定**时可以取消进气键技能，
    #     代价是额外 100 气（手续费）。它给"出招被读到"的一方一个出口 ——
    #     总纲要求"被反制不能是纯挫败"，这是攻击侧的版本。
    #     判断见 CanCancelStartup()：只有 lv1/lv2、var(4) = 0、time >= 2。
    # ========================================================================
    if command = "GAS_FZ" && (($canLv4 && power >= 600) || ($canStartup && power >= 700)) {
        if $canStartup {
            powerAdd{value: -100}     # T3 手续费（技能本身的 600 在状态里扣）
        }
        changeState{value: 1300}
    }

    if command = "GAS_DZ" && (($canLv4 && power >= 600) || ($canStartup && power >= 700)) {
        if $canStartup {
            powerAdd{value: -100}
        }
        changeState{value: 1400}
    }

    if command = "GAS_Z" && (($canLv4 && power >= 800) || ($canStartup && power >= 900)) {
        if $canStartup {
            powerAdd{value: -100}
        }
        changeState{value: 3000}
    }

    # ========================================================================
    # 【③ 中型技能】C 系（键盘 C = 按钮 c），消耗 300~400 气
    #   C 射箭 / ↓C 斜下射 / →C 升斬 / ←C 后撤投剑
    #   ★ T3 同②：也能从普通技的前摇取消进来（+100 手续费）
    # ========================================================================
    if command = "GAS_BC" && (($canLv3 && power >= 400) || ($canStartup && power >= 500)) {
        if $canStartup {
            powerAdd{value: -100}
        }
        changeState{value: 1200}
    }

    if command = "GAS_FC" && (($canLv3 && power >= 400) || ($canStartup && power >= 500)) {
        if $canStartup {
            powerAdd{value: -100}
        }
        changeState{value: 1100}
    }

    if command = "GAS_DC" && (($canLv3 && power >= 300) || ($canStartup && power >= 400)) {
        if $canStartup {
            powerAdd{value: -100}
        }
        changeState{value: 1150}
    }

    if command = "GAS_C" && (($canLv3 && power >= 300) || ($canStartup && power >= 400)) {
        if $canStartup {
            powerAdd{value: -100}
        }
        changeState{value: 1000}
    }

    # ========================================================================
    # 【② 闪身】A + Z 同时按（KOF97 的 A+B），**不耗气**
    #   ★ 为什么必须有：箭矢飞得高、跳不过去，没有突进手段就只能一直防 —— 
    #     射箭方 camping 无解。这一条就是那个解。
    #   优先级：放在气键技能之前（被压制的当下最需要它），但要求 ctrl
    #     （只能从自由状态发动，不能取消攻击）—— 否则可以无限闪。
    # ========================================================================
    if command = "FLASH_F" && stateType != A && ctrl {
        changeState{value: 110}
    }

    if command = "FLASH_B" && stateType != A && ctrl {
        changeState{value: 115}
    }

    if command = "FLASH_D" && stateType != A && ctrl {
        changeState{value: 117}
    }

    # ========================================================================
    # 【④ 投技】贴身 + 前/后 + 重拳或重脚（不耗气）
    #   比 ⑧ 的站立单按窄，必须排在其前面
    # ========================================================================
    if (command = "y" || command = "b") && stateType = S && ctrl &&
        ((command = "holdfwd" && p2BodyDist X < 3) ||
            (command = "holdback" && p2BodyDist X < 5)) {
        changeState{value: 800}
    }

    # ========================================================================
    # 【⑤ 前冲 / 后跳】→→ / ←←
    # ========================================================================
    if command = "FF" && stateType = S && ctrl {
        changeState{value: 100}
    }

    if command = "BB" && stateType = S && ctrl {
        changeState{value: 105}
    }

    # ========================================================================
    # 【⑥ 蹲普通技】↓ + A / S / Z / X（不耗气）
    #   ★ 必须写 command = "holddown"，否则会被 ⑧ 的站立规则抢走
    # ========================================================================
    if command = "x" && command = "holddown" && stateType = C && $canLv1 {
        changeState{value: 400}
    }

    if command = "a" && command = "holddown" && stateType = C && $canLv1 {
        changeState{value: 430}
    }

    if command = "y" && command = "holddown" && stateType = C && $canLv2 {
        changeState{value: 410}
    }

    if command = "b" && command = "holddown" && stateType = C && $canLv2 {
        changeState{value: 440}
    }

    # ========================================================================
    # 【⑦ 空中普通技】空中 + A / S / Z / X（不耗气，不参与取消链）
    # ========================================================================
    if command = "x" && stateType = A && ctrl {
        changeState{value: 600}
    }

    if command = "a" && stateType = A && ctrl {
        changeState{value: 630}
    }

    if command = "y" && stateType = A && ctrl {
        changeState{value: 610}
    }

    if command = "b" && stateType = A && ctrl {
        changeState{value: 640}
    }

    # ========================================================================
    # 【⑦b T1 同键二次】同一个普通键按两次（.cmd 窗口 36 tick）→ 二段（State 250~253）
    #   ★ 必须排在 ⑧ 的单键规则**之前**：第二次按键时 `TAP_x` 与 `x` 同时成立，
    #     路由是"先命中者生效"，写反了就永远只会出单键那一招，二段不可能出现。
    #   ★ 二段登记为 lv4（连段收尾），接进来之后不可再取消；放行条件见 CanTap()。
    # ========================================================================
    if command = "TAP_A" && $canTap {
        changeState{value: 250}
    }

    if command = "TAP_S" && $canTap {
        changeState{value: 251}
    }

    if command = "TAP_Z" && $canTap {
        changeState{value: 252}
    }

    if command = "TAP_X" && $canTap {
        changeState{value: 253}
    }

    # ========================================================================
    # 【⑧ 站立普通技】A / S / Z / X（不耗气）
    # ========================================================================
    if command = "x" && command != "holddown" && stateType = S && $canLv1 {
        changeState{value: 200}
    }

    if command = "a" && command != "holddown" && stateType = S && $canLv1 {
        changeState{value: 230}
    }

    if command = "y" && command != "holddown" && stateType = S && $canLv2 {
        changeState{value: 210}
    }

    if command = "b" && command != "holddown" && stateType = S && $canLv2 {
        changeState{value: 240}
    }

    # ========================================================================
    # 【⑨ 嘲讽】
    # ========================================================================
    if command = "start" && command != "holddown" && stateType != A && ctrl {
        changeState{value: 195}
    }

# End of file: roundState = 2
# =============================================================================
}
