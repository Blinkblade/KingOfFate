; ============================================================================
; KingOfFate — Base Fighter Template : 动画与判定框（.air）
;
; .air 负责两件事：
;   1) 帧序列 —— 每帧用 组号,图号 指向 .sff 里的精灵
;   2) 判定框 —— Clsn1 攻击框（红） / Clsn2 受击框（蓝）
;
; 帧行格式：
;     组,图, X偏移,Y偏移, 持续帧数
;     -1 出现在"持续帧数"位置 = 动画到此结束
;     Loopstart = 循环回到本 Action 开头
;
; 判定框格式（相对角色脚底原点，y 向上为负）：
;     Clsn1[0] = x1, y1, x2, y2     攻击框
;     Clsn2[0] = x1, y1, x2, y2     受击框
;     Clsn2Default: N               整个动画的默认受击框，帧内 Clsn2 会覆盖它
;
; ★★★ P1 实验 E4 的结论（本文件最重要的使用须知）★★★
;   Clsn1 与 Clsn2 完全独立：
;     - 改 Clsn1 只影响"打不打得到别人"，不影响自己的受击框，也不影响精灵渲染
;     - 改 Clsn1 **完全不影响伤害** —— 伤害由 .zss 里 hitDef 的 damage 决定
;   所以"调整打击范围"是低风险改动，可以放心局部调整。
;
; ★★★ P1 实验 E3 的结论 ★★★
;   动画总时长 = 各帧持续数之和。
;   状态脚本里 hitDef 挂在 `if animElem = 3`（见 _template.zss），
;   所以**首帧的持续数决定了出招快慢**：把首帧从 2 改到 20，
;   命中时点就从第 4 tick 推迟到第 22 tick。
;   → 调手感：改帧数，不用改逻辑。
;
; 依据：docs/ikemen_character_architecture.md §6
; 实测对照：game/chars/p1_kfm_zss_lab/kfm.air
; ============================================================================

; ---------------------------------------------------------------------------
; 站立待机（Stand）—— 最基础的动作，必须有
; 骨架里先用 0,0 占位；接上真实 .sff 后把组号/图号改成正确的精灵
; ---------------------------------------------------------------------------
[Begin Action 0]
Clsn2Default: 2
 Clsn2[0] = -10,  0, 19,-80
 Clsn2[1] =   0,-94, 12,-80
0,0, 0,0, 8
0,1, 0,0, 8
0,2, 0,0, 8
0,3, 0,0, 8
0,4, 0,0, 8
0,5, 0,0, -1

; ---------------------------------------------------------------------------
; 嘲讽（Taunt）—— 对应 _template.zss 的 StateDef 195
; ---------------------------------------------------------------------------
[Begin Action 195]
Clsn2Default: 2
 Clsn2[0] = -10,  0, 19,-80
 Clsn2[1] =   0,-94, 12,-80
0,0, 0,0, 10
0,1, 0,0, 10
0,2, 0,0, 10
0,3, 0,0, 10

; ---------------------------------------------------------------------------
; 站立轻拳（Stand Light Punch）—— 对应 _template.zss 的 StateDef 200
;
; 这份是**新招式的复制样板**。结构：
;   帧1 (2 tick)  起手，只有受击框
;   帧2 (1 tick)  过渡，只有受击框
;   帧3 (4 tick)  ★ 攻击帧：同时有 Clsn1 攻击框 和 Clsn2 受击框
;   帧4 (3 tick)  收招
;   帧5 (2 tick)  回位
; 总时长 2+1+4+3+2 = 12 tick
;
; hitDef 在 animElem = 3 触发 → 正好是上面"帧3"的第一帧
; ---------------------------------------------------------------------------
[Begin Action 200]
Clsn2Default: 2
 Clsn2[0] = -10,  0, 19,-80
 Clsn2[1] =   0,-94, 12,-80
200,0, 0,0, 2
200,1, 0,0, 1
Clsn1: 1
 Clsn1[0] =  16,-80, 61,-71
Clsn2: 3
 Clsn2[0] =  19,  0,-10,-80
 Clsn2[1] =   6,-94, 18,-78
 Clsn2[2] =  19,-80, 61,-71
200,2, 0,0, 4
200,1, 0,0, 3
200,0, 0,0, 2

