# ============================================================================
# KingOfFate — Base Fighter Template : 主体状态脚本（ZSS）
#
# 这里放角色的"状态主体"：每个 [StateDef N] 是一个状态。
# 命令名 → 状态号的映射在 command.zss，不在本文件。
#
# 本模板实现的状态（T2/T4/T5）：
#   180   胜利姿势        —— 回合结束时引擎要求的状态（占位）
#   195   嘲讽            —— 非攻击状态样板
#   200   站立轻拳 A      —— 可取消（Cancel）
#   210   站立重拳 C
#   230   站立轻脚 B      —— 可取消（Cancel）
#   240   站立重脚 D
#   800   投技起手        —— hitDef 抓人，成功后 p1stateno 810 / p2stateno 820
#   810   投技执行        —— targetBind + targetLifeAdd + targetState 821
#   1000  Placeholder Special（QCF + A）      不耗气
#   1010  Placeholder EX Special（QCF + C）   耗 500 气，击倒
#
# 由 hits.zss（受击方，本角色自己的状态）实现的：
#   820  被抓住（等待被甩出）   —— changeAnim2 播攻击者的 AIR
#   821  被甩到空中 → 触地 5100，含受身（recovery → 5200 / 5210）
#
# 由 IKEMEN Common State 提供、本模板**不重复实现**的（T1/T3）：
#   0/10/11/12  站立 / 站↔蹲
#   20/21       走前 / 走后
#   40-52       跳跃（起跳 / 上升 / 空中 / 下落 / 落地）
#   100/105     前冲 / 后跳
#   120/130-155 防御（起手 / 站防 / 蹲防 / 空防 / 防御结束 / 防御后退）
#   5000-5210   受击 / 倒地 / 起身 / 受身
#   出处：engine/ikemen-go/data/common1.cns.zss
#
# 语法硬规则（架构文档 §5.2）：
#   * sctrl 的左花括号必须与控制器名同行：  hitDef{   ✅   hitDef   ❌
#   * [StateDef N; ...] 头部用分号分隔、] 收尾
#   * 触发器就是 if <表达式> { ... }，不用 trigger1 = 的旧写法
#   * 范围匹配：[a, b] 闭区间，[a, b) 半开区间
#
# 实测对照：game/chars/p1_kfm_zss_lab/kfm.zss
# ============================================================================


# ============================================================================
# 函数
# ============================================================================
# EndState(type)：状态结束后回到站立（type=0）或下蹲（type=1）。
# 每个攻击状态都必须用它收尾，否则状态无法退出（架构文档 §5.4 第 5 条）。
[Function EndState(type)]
if animTime = 0 {
    changeState{value: 11 * $type; ctrl: roundState > 1}
}

# CSnd(bank, sound, channel)：播放本角色 .snd 里的音效。
# 参数语义见 IKEMEN 的 playSnd sctrl；S 前缀表示"角色自己的 sound"。
[Function CSnd(bank, sound, c)]
playSnd{value: S $bank, $sound; channel: $c}


# ============================================================================
# 胜利姿势（Win Pose）—— 回合结束时引擎会把胜者切到这个状态
#
# ★ 为什么"必须有"：回合结束（KO / 时间到）后，引擎会尝试把胜者切换进
#   State 180。如果角色与公共服务态都没有 180，引擎会打印：
#     WARNING: <char> (nn) in state 180: changed to invalid state 180 (from state 0)
#   （P2 审计时实测踩到；KFM 也是在 kfm.zss 里自己定义 180/181 的。）
#
# 这里是**占位实现**：只播一段胜利姿势动画，不做姿势选择。
# 多姿势（181-189）、胜利台词、按条件选姿势等表现层内容属于
# P7（Character Skills & Presentation），不在 P2 范围。
#
# 注意：本状态**不调用 EndState** —— 胜者要一直保持姿势，
#       直到引擎的回合结束计时把对局推进到下一回合。
# ============================================================================
[StateDef 180;
type: S; movetype: I; physics: S;
anim: 180; ctrl: 0;
velset: 0, 0;
sprpriority: 1;]

notHitBy{value: SCA; time: 1}


# ============================================================================
# 嘲讽（Taunt）—— 非攻击状态的最小样板
# 要点：有明确时长（time）、结束时把控制权还回去（ctrlSet + EndState）
# ============================================================================
[StateDef 195;
type: S; movetype: I; physics: S;
anim: 195; ctrl: 0;
velset: 0, 0;
sprpriority: 2;]

# 40 tick 后恢复可操作
if time = 40 {
    ctrlSet{value: 1}
}

# 状态结束 → 回到站立
call EndState(0);


# ============================================================================
# 站立轻拳 A（Stand Light Punch）—— 攻击状态的标准样板
#
# ★ 这是"每加一个新招式就复制一份"的模板。它展示了攻击状态的全部必备结构：
#   1) 状态头：type/movetype/physics/anim/ctrl/velset/poweradd/sprpriority
#   2) 在明确的 animElem 上触发 hitDef
#   3) 出招音效
#   4) EndState 收尾
#
# ★ Cancel（T7）：本状态是**可取消**的。
#   - 进入时清 var(0)（cancelUsed），见下方 time = 0
#   - 可取消窗口 = 首个攻击帧（animElemTime(3) >= 0）之后，命中与否都可以取消
#   - 具体路由在 command.zss 的 [Function Combo] + 必杀技分支
# ============================================================================
[StateDef 200;
type: S;                              # S-站立 / C-下蹲 / A-空中 / L-倒地
movetype: A;                          # A-攻击 / I-待机 / H-受击
physics: S;                           # S-站立 / C-下蹲 / A-空中
juggle: 1;                            # 本招消耗的空中追打点数
velset: 0, 0;                         # 出招期间不移动
ctrl: 0;                              # 出招期间不可操作
anim: 200;                            # 播放动画 200（定义在 _template.air）
poweradd: 20;                         # 出招集气量（T6：普通攻击获得 Power）
sprpriority: 2;]                      # 绘制层级：2 = 在对手前面

# 每次进入本状态都重置"已取消"标记：一次普通技只能取消一次
if time = 0 {
    var(0) := 0;
}

# 动画推进到第 3 个元素时产生攻击判定。
# 注意：这个时点由 _template.air 里 Action 200 的帧数决定 ——
#       想改"出招快慢"，改 .air 的帧数，不用改这里（P1 实验 E3）。
if animElem = 3 {
    hitDef{
        attr: S, NA;                  # 属性：S-站姿, NA-普通攻击
        damage: 25, 0;                # 伤害, 防御伤害  ← E2 验证：掉血精确等于此值
        animtype: Light;              # 受击动画类型：Light/Medium/Heavy/Back
        guardflag: MA;                # 可被防住的方式
        hitflag: MAF;                 # 可命中的目标状态
        priority: 3, Hit;             # 攻击优先级 0-7（默认 4）
        pausetime: 8, 8;              # 命中停顿：攻击方, 防守方
        sparkno: 0;                   # 命中火花动画号
        sparkxy: -10, -76;            # 火花偏移
        hitsound: 5, 0;               # 命中音效
        guardsound: 6, 0;             # 防御音效
        ground.type: High;            # 地面受击类型
        ground.slidetime: 5;          # 地面滑动时间
        ground.hittime: 11;           # 地面受击硬直
        ground.velocity: -4;          # 地面击退速度
        airguard.velocity: -1.9, -.8; # 空中防御击退
        air.type: High;               # 空中受击类型
        air.velocity: -1.4, -3;       # 空中击退
        air.hittime: 15;              # 空中受击硬直
    }
}

# 第 1 tick 播报出招音效
if time = 1 {
    call CSnd(0, 0, 1);
}

# 状态结束 → 回到站立
call EndState(0);


# ============================================================================
# 站立重拳 C（Stand Heavy Punch）
# 与 200 的差异即"轻 vs 重"的差异：伤害更高、出招更慢、收招更长、集气更多。
# 重攻击**不可取消**（KOF 惯例），所以这里不重置 var(0)。
# ============================================================================
[StateDef 210;
type: S; movetype: A; physics: S;
juggle: 2; velset: 0, 0; ctrl: 0;
anim: 210;
poweradd: 35;
sprpriority: 2;]

# 重拳慢：命中判定在第 5 个元素（animElem = 5）
if animElem = 5 {
    hitDef{
        attr: S, NA;
        damage: 70, 5;                # 伤害 70，防御伤害 5（重技有chip）
        animtype: Medium;
        guardflag: MA;
        hitflag: MAF;
        priority: 4, Hit;
        pausetime: 12, 12;            # 重技停顿更久 → 手感更"重"
        sparkno: 0;
        sparkxy: -10, -76;
        hitsound: 5, 1;
        guardsound: 6, 0;
        ground.type: High;
        ground.slidetime: 8;
        ground.hittime: 17;
        ground.velocity: -8;          # 击退更远
        airguard.velocity: -2.6, -1.1;
        air.type: High;
        air.velocity: -2.4, -4;
        air.hittime: 20;
    }
}

if time = 1 {
    call CSnd(0, 1, 1);
}

call EndState(0);


# ============================================================================
# 站立轻脚 B（Stand Light Kick）—— 可取消（同 200）
# ============================================================================
[StateDef 230;
type: S; movetype: A; physics: S;
juggle: 1; velset: 0, 0; ctrl: 0;
anim: 230;
poweradd: 20;
sprpriority: 2;]

if time = 0 {
    var(0) := 0;
}

if animElem = 3 {
    hitDef{
        attr: S, NA;
        damage: 30, 0;
        animtype: Light;
        guardflag: MA;
        hitflag: MAF;
        priority: 3, Hit;
        pausetime: 8, 8;
        sparkno: 0;
        sparkxy: -10, -70;
        hitsound: 5, 0;
        guardsound: 6, 0;
        ground.type: High;
        ground.slidetime: 6;
        ground.hittime: 12;
        ground.velocity: -5;          # 比轻拳踢得远一点
        airguard.velocity: -2, -.9;
        air.type: High;
        air.velocity: -1.6, -3.1;
        air.hittime: 16;
    }
}

if time = 1 {
    call CSnd(0, 2, 1);
}

call EndState(0);


# ============================================================================
# 站立重脚 D（Stand Heavy Kick）
# ============================================================================
[StateDef 240;
type: S; movetype: A; physics: S;
juggle: 2; velset: 0, 0; ctrl: 0;
anim: 240;
poweradd: 40;
sprpriority: 2;]

if animElem = 3 {
    hitDef{
        attr: S, NA;
        damage: 75, 5;
        animtype: Heavy;
        guardflag: MA;
        hitflag: MAF;
        priority: 4, Hit;
        pausetime: 13, 13;
        sparkno: 0;
        sparkxy: -10, -66;
        hitsound: 5, 2;
        guardsound: 6, 0;
        ground.type: High;
        ground.slidetime: 10;
        ground.hittime: 19;
        ground.velocity: -9;
        airguard.velocity: -2.8, -1.2;
        air.type: High;
        air.velocity: -2.6, -4.2;
        air.hittime: 22;
    }
}

if time = 1 {
    call CSnd(0, 3, 1);
}

call EndState(0);


# ============================================================================
# 基础投技（T4） —— 起手：抓人
#
# 结构（照抄 KFM 的投技组织，见 kfm.zss:765）：
#   hitDef 的 attr 必须是 **S, NT**（Normal Throw）
#   priority 必须是 Miss 或 Dodge，且数值要低（1），否则会压过普通攻击
#   p1stateno / p2stateno 指定"抓到之后"双方各自进入的状态
#   guard.dist: 0 —— 贴身时不允许对手进入防御
#
# 触发条件在 command.zss §⑤：贴身 + 对手在地面 + 对手不在受击硬直。
# 抓不到时 moveContact = 0，EndState 直接回站立。
# ============================================================================
[StateDef 800;
type: S; movetype: A; physics: S;
juggle: 0; velset: 0, 0; ctrl: 0;
anim: 800;
poweradd: 10;
sprpriority: 2;]

if time = 0 {
    hitDef{
        attr: S, NT;            # Standing, Normal Throw
        hitflag: M-;            # 只影响"没在被打"的地面目标 —— 防止投技接进连段
        priority: 1, Miss;      # 投技优先级必须低，且必须是 Miss/Dodge
        sparkno: -1;            # 无火花
        p1sprpriority: 1;       # 投技时把自己画在对手前面
        p1facing: 1;
        p2facing: 1;            # 强制对手面向自己
        p1stateno: 810;         # 抓到 → 自己进 810
        p2stateno: 820;         # 抓到 → 对手进本角色 hits.zss 的 820
        guard.dist: 0;          # 贴身时禁止对手防御
        fall: 1;                # 对手最终倒地
    }
}

if time = 1 {
    call CSnd(800, 0, 1);
}

call EndState(0);


# ============================================================================
# 基础投技 —— 执行：把对手甩出去
#
# 三个必备环节：
#   1) targetBind —— 每个动画元素都必须把对手绑在身上（否则对手会卡住）
#   2) targetLifeAdd —— 投技伤害（不经过 hitDef.damage）
#   3) targetState —— 放开对手，让他进自己的受击/倒地流程
# ============================================================================
[StateDef 810;
type: S; movetype: A; physics: N;
anim: 810;
poweradd: 0;
sprpriority: 1;]

# var(2) 记录投技开始时是否按住前 —— 决定把对手甩向哪边
if time = 0 {
    var(2) := command = "holdfwd";
}

# 抬起：把对手绑在身前
if animElemTime(1) < 0 {
    targetBind{pos: 28, 0}
}
if animElemTime(2) >= 0 && animElemTime(5) < 0 {
    targetBind{pos: 52, -10}
}
if animElemTime(5) >= 0 && animElemTime(6) < 0 {
    targetBind{pos: 44, -40}
}
if animElemTime(6) >= 0 && animElemTime(7) < 0 {
    targetBind{pos: 36, -70}
}

# 若起手时按住前，则转身并把对手甩到身后
if var(2) && animElem = 6 {
    turn{}
    posAdd{x: -30}
    targetFacing{value: -1}
}

# 甩出：脱手 + 结算伤害 + 让对手回到他自己的倒地流程（821 → 5100）
if animElem = 7 {
    targetBind{pos: -30, -50}
    targetLifeAdd{value: -90}
    targetState{value: 821}
}

if animElem = 7 {
    call CSnd(800, 1, 1);
}

call EndState(0);


# ============================================================================
# Placeholder Special（T5）—— 236 + A：验证"方向输入 → 路由 → 特殊状态"全链路
#
# 它存在的目的**不是**设计招式，而是让这条链可被验证：
#   方向输入 → .cmd 的 QCF_x → command.zss 路由 → State 1000
#   → 动画 1000 → hitDef（animElem = 6）→ EndState
#
# 不耗气。集气 40。
#
# ★ 注意 var(0)：进入必杀技时置 1，配合 var(0) 在 200/230 入口清零，
#   实现"一次普通技只能取消一次"（T7）。
# ============================================================================
[StateDef 1000;
type: S; movetype: A; physics: S;
juggle: 4; velset: 0, 0; ctrl: 0;
anim: 1000;
poweradd: 40;
sprpriority: 2;]

if time = 0 {
    var(0) := 1;                # 消耗掉本次 Cancel 机会
}

# 前冲一小段：让"必杀技"看起来在位移
if animElem = 2 {
    posAdd{x: 14}
}
if animElem = 3 {
    posAdd{x: 8}
}

# 命中判定（近版 / 远版：近距离伤害略高，这是 KFM 的做法）
if animElem = 6 {
    if p2BodyDist X < 40 {
        hitDef{
            attr: S, SA;            # SA = Special Attack
            damage: 95, 6;
            animtype: Hard;
            guardflag: MA;
            hitflag: MAF;
            priority: 5, Hit;
            pausetime: 15, 15;
            sparkxy: -10, -60;
            hitsound: 5, 4;
            guardsound: 6, 0;
            ground.type: Low;
            ground.slidetime: 12;
            ground.hittime: 17;
            ground.velocity: -5, -3.5;
            air.velocity: -4, -3;
            air.hittime: 20;
        }
    } else {
        hitDef{
            attr: S, SA;
            damage: 85, 6;
            animtype: Hard;
            guardflag: MA;
            hitflag: MAF;
            priority: 4, Hit;
            pausetime: 15, 15;
            sparkxy: -10, -60;
            hitsound: 5, 4;
            guardsound: 6, 0;
            ground.type: Low;
            ground.slidetime: 12;
            ground.hittime: 17;
            ground.velocity: -7;
            air.velocity: -4, -3;
            air.hittime: 20;
        }
    }
}

if time = 1 {
    call CSnd(0, 3, 1);
}

call EndState(0);


# ============================================================================
# Placeholder EX Special（T6）—— 236 + C：消耗 500 气的演示入口
#
# 这是模板里**唯一**一个"先检查气、再扣气"的动作，用来固定写法：
#   气量检查 → command.zss 的路由（power >= 500）
#   气量扣除 → 本状态 time = 0 的 powerAdd{value: -500}
# 不把气量检查放在状态里，是因为那样会先进状态再退出，观感上会"抖一下"。
# ============================================================================
[StateDef 1010;
type: S; movetype: A; physics: S;
juggle: 5; velset: 0, 0; ctrl: 0;
anim: 1010;
poweradd: 0;                    # 出招本身不集气（它要花气）
sprpriority: 2;]

if time = 0 {
    powerAdd{value: -500}       # ★ 气量扣除在这里
    var(0) := 1;
}

if animElem = 2 {
    posAdd{x: 18}
}
if animElem = 3 {
    posAdd{x: 10}
}

# 与 1000 的差异：伤害更高、强制击倒（fall: 1）—— 用于验证倒地/起身链路
if animElem = 6 {
    hitDef{
        attr: S, SA;
        damage: 130, 10;
        animtype: Hard;
        guardflag: MA;
        hitflag: MAF;
        priority: 5, Hit;
        pausetime: 18, 18;
        sparkxy: -10, -60;
        hitsound: 5, 5;
        guardsound: 6, 0;
        ground.type: Low;
        ground.slidetime: 16;
        ground.hittime: 22;
        ground.velocity: -6, -5;
        air.velocity: -5, -4;
        air.hittime: 24;
        fall: 1;                # ★ 强制倒地
    }
}

if time = 1 {
    call CSnd(0, 4, 1);
}

call EndState(0);


# ============================================================================
# [StateDef -3] —— 每 tick 执行，且只在角色自己的状态文件内生效
# （与 -1 的区别见架构文档 §4.3）。KFM 用它放落地音效，这里保留同一个位置，
# 供后续角色直接扩展（例如：落地扬灰、脚步声）。
# 模板阶段为空 —— 不为了"看起来完整"塞无意义内容。
# ============================================================================
[StateDef -3]
