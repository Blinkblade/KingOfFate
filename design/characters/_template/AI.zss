# ============================================================================
# KingOfFate — Base Fighter Template : CPU AI（AI.zss）
#
# ★★★ 两条必须记住的机制（P1 实验 E6 直接验证）★★★
#
#   1. AI **不走命令系统**。它不模拟按键、不看 .cmd、不看 command.zss，
#      而是直接 `changeState{value: N}`。
#      → 所以改 .cmd 不会影响 AI；反过来，AI 能做出的动作不受命令定义限制。
#
#   2. **优先级 = 本文件的书写顺序**。同一个 tick 里，先出现的 changeState
#      先生效，没有权重、没有评分、没有回退。
#      → 一条写得太靠前、条件太宽的规则会**静默废掉它后面的一切**。
#         E6 就是活生生的例子：链首插一条 `if … { changeState{value: 210} }`，
#         AI 行为立刻从 7 种状态塌缩成单一招式，且对手全程未掉血。
#
# 因此：**顺序表就是这个 AI 的设计本身**，不是实现细节。
#
# 结构（照抄 KFM 的分层）：
#   [StateDef -4]  全局状态：不受 pause/superPause 停止，无 helper 限制
#   [StateDef -1]  每 tick 执行的主循环，内部分三大块：
#                    ① 中立（有控制权、没在出招）  → 反应、进攻、移动
#                    ② 命中后（moveContact）        → 连段衔接、必杀取消
#                    ③ 特殊个案                     → follow-up、受身
#
# 依据：docs/ikemen_character_architecture.md §7
# 实测对照：game/chars/p1_kfm_zss_lab/AI.zss
# ============================================================================


# ============================================================================
# [StateDef -4] —— 全局状态
# 用"非战斗状态下的收尾"：例如跑动状态在回合结束后要强制解除。
# ============================================================================
[StateDef -4]

if stateNo = 100 && roundState != 2 && aiLevelF {
    changeState{value: 0; ctrl: 1}
}


# ============================================================================
# [StateDef -1] —— AI 主循环（每 tick）
# ============================================================================
[StateDef -1]

# 只在"战斗中 + 由 AI 操作 + 不是待机/暂停"时决策。
# ignoreHitPause = 命中停顿期间也要继续思考。
ignoreHitPause if aiLevelF && roundState = 2 && !standby {

    # ------------------------------------------------------------------------
    # 关闭引擎的默认自动行为 —— 移动/跳跃必须由 AI 自己决定
    # ------------------------------------------------------------------------
    assertSpecial{flag: nojump; flag2: noairjump}   # 禁默认跳跃
    assertSpecial{flag: nowalk; flag2: nobrake}     # 禁默认走路

    # ------------------------------------------------------------------------
    # 常用派生量（集中算一次，后面复用）
    # 决策质量。aiLevelF 是 1-8 的 AI 等级浮点值。
    # KFM 用 `random <= (系数 * (aiLevelF ** 2 / 48.0))` 把等级映射成概率。
    # ------------------------------------------------------------------------
    let inrange = 0;
    let grounded  = p2StateType = S || p2StateType = C;   # 对手在地面
    let lights    = stateNo = 200 || stateNo = 230;       # 当前是轻技
    let heavy     = stateNo = 210 || stateNo = 240;       # 当前是重技
    let CC        = cond(numTarget, target,getHitVar(hittime), 0);  # 对手剩余硬直
    let hitfall   = p2,hitFall || $CC > 8;

    # ========================================================================
    # ① 中立：当前有控制权 / 在待机 / 在跑动  —— 决定"现在做什么动作"
    # ========================================================================
    if (ctrl || stateNo = 20 || stateNo = 100) {
        if stateType != A {

            # ---- 反手（对手在攻击我们）------------------------------------
            if p2MoveType = A && p2,time > 1 {
                # 反手超必杀：气满 + 距离合适
                if power >= 1000 && p2,alive &&
                    p2BodyDist x = [-10, 80] && $grounded {
                    changeState{value: 3050}
                }
            }

            # ---- 投技：贴身 + 对手在地面 --------------------------------
            if random <= (310 * (aiLevelF ** 2 / 48.0)) && stateType = S &&
                p2BodyDist x < 30 && $grounded && p2MoveType != H {
                changeState{value: 800}
            }

            # ---- 防御 ---------------------------------------------------
            if p2MoveType = A && inGuardDist &&
                random <= (700 * (aiLevelF ** 2 / 48.0)) &&
                p2BodyDist x > -20 && p2StateType != L && ctrl {
                assertSpecial{flag: autoguard}
                changeState{value: 120}
            }

            # ---- 普通技：按距离挑轻技/重技 ------------------------------
            if p2BodyDist x < 55 && $grounded {
                changeState{value: 200}
            }
            if p2BodyDist x < 60 && random <= (425 * (aiLevelF ** 2 / 48.0)) {
                changeState{value: 210}
            }
        }
    # ========================================================================
    # ② 命中后：连段衔接（moveContact = [1,3] 表示刚打中）
    # ========================================================================
    } else if moveContact = [1, 3] && hitPauseTime = 0 && stateType != A {

        # 轻技 → 重技 的连段
        if $lights && moveHit && p2BodyDist x < 60 && random < (600 * (aiLevelF ** 2 / 48.0)) {
            changeState{value: 210}
        }

        # 重技 → 必杀取消（气够时）
        if $heavy && moveHit && jugglePoints(p2, ID) >= 7 &&
            random < (800 * (aiLevelF ** 2 / 48.0)) {
            if p2BodyDist x = [40, 120] && $grounded {
                changeState{value: 1000}
            }
        }
    }

    # ========================================================================
    # ③ 移动：走路 / 跑 / 跳
    # 这一块放在后面，意味着"攻击的优先级高于移动"。
    # ========================================================================
    mapSet{map: "AIw"; value: 0}
    if p2BodyDist x = [25, 120] && $grounded {
        mapSet{map: "AIw"; value: 1}
    }

    # 走路（用引擎的公共状态 20）
    if stateType = S && ctrl && stateNo != 100 && random < 249 &&
        map(AIw) != 0 {
        changeState{value: 20}
    }

    # 前跑
    if stateType != A && (ctrl || stateNo = 20) && stateNo != 100 &&
        random <= (396 * (aiLevelF ** 2 / 48.0)) &&
        p2BodyDist x >= 120 {
        changeState{value: 100}
    }

    # 跳（低概率；必须在最后，否则会抢走攻击决策）
    if stateType != A && ctrl && random < (375 * (aiLevelF ** 2 / 48.0)) &&
        p2BodyDist x > 90 {
        changeState{value: 40}
        sysVar(1) := 1;                    # 1 = 前跳, -1 = 后跳
    }

}

# ============================================================================
# 顺序自查清单（每改一次顺序都要过一遍）
#
#   [ ] 有没有哪条规则的条件宽到会"吃掉"后面所有规则？
#   [ ] 移动类规则是否都排在攻击类规则之后？
#   [ ] 概率系数是否都带了 aiLevelF，以保证低难度确实更弱？
#   [ ] 新增的 changeState 目标状态是否真的存在（拼错状态号 = 静默无反应）？
#
# 验证方法：跑一局 AI vs AI，用 Ctrl+D 读状态号序列，
#           确认状态号是**多样**的，而不是塌缩成一两个。
#           工具见 tests/p1/README.md。
# ============================================================================
