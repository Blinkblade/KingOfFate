; ============================================================================
; KingOfFate — Base Fighter Template
; 角色定义文件（.def）：文件名映射 + 角色元信息。本文件不含任何战斗逻辑。
;
; 用法：把整个 _template/ 目录复制成 game/chars/<你的角色名>/，然后：
;   1) 把所有 `_template` 前缀替换成你的角色名
;   2) 改下面的 name / displayname / author
;   3) 用 P5 的工具链产出 <角色名>.sff 与 <角色名>.snd
;   4) pwsh -File scripts/sync_game_content.ps1   → 同步到引擎运行目录
;
; 依据：docs/ikemen_character_architecture.md §2（文件构成）与 §11（对 P2 的输入）
; 实测来源：game/chars/p1_kfm_zss_lab/p1_kfm_zss_lab.def
; ============================================================================

; ---------------------------------------------------------------------------
; 角色信息
; ---------------------------------------------------------------------------
[Info]
name         = "KOF Template"      ; 内部名，参战命令行 -p1 <name> 用它
displayname  = "KOF Template"      ; 画面上显示的名字
versiondate  = 01,01,2026          ; MM-DD-YYYY 或 X.XX
mugenversion = 1.0                 ; 兼容的 M.U.G.E.N 版本，IKEMEN 下保持 1.0
author       = "KingOfFate"
pal.defaults = 1,2,3,4             ; 默认调色板优先级

; ---------------------------------------------------------------------------
; 文件映射 —— 这是本文件唯一的实质内容
; 注意：引擎的 stcommon 搜索路径包含 data/，所以 common1.cns.zss 来自画面包，
;       属于"公共状态"，不是这个角色自己的文件。
; ---------------------------------------------------------------------------
[Files]
cmd      = _template.cmd       ; 命令定义：物理按键 → 命令名
cns      = _template.const     ; 常量：体力/尺寸/速度/位移（IKEMEN 下仍是独立文件）
st       = _template.zss       ; 主体状态脚本（ZSS）
st2      = hits.zss            ; 额外状态：受击方 / 特殊状态
st3      = command.zss         ; 命令路由：命令名 → 状态号
st4      = AI.zss              ; CPU AI 脚本
stcommon = common1.cns.zss     ; 公共状态（来自 data/ 或画面包）——所有角色共用
sprite   = _template.sff       ; 精灵图容器（需 P5 工具链产出）
anim     = _template.air       ; 动画 + 判定框
sound    = _template.snd       ; 音效容器（需 P5 工具链产出）
movelist = movelist.dat        ; 出招表（IKEMEN 特有，纯展示）

; ---------------------------------------------------------------------------
; 选人画面的按键 → 调色板映射
; KingOfFate 定位为 4 键：x = 轻拳, y = 重拳, a = 轻脚, b = 重脚
; 这里的按键名是角色按钮名（不是物理键），与 _template.cmd 的 [Remap] 对应。
; ---------------------------------------------------------------------------
[Palette Keymap]
x = 1                          ; 按轻拳选调色板 1
y = 2                          ; 按重拳选调色板 2
a = 3                          ; 按轻脚选调色板 3
b = 4                          ; 按重脚选调色板 4

; ---------------------------------------------------------------------------
; Arcade 模式的剧情板（可选）。没有对应素材时整段删掉。
; ---------------------------------------------------------------------------
;[Arcade]
;intro.storyboard  = intro.def
;ending.storyboard = ending.def
