# ============================================================================
# KingOfFate — Base Fighter Template : 命令路由（command.zss）
#
# 本文件回答唯一一个问题：**哪个命令进入哪个状态**。
#
# ★★★ 最重要的一条规则（P1 实验 E5 直接验证）★★★
#   [StateDef -1] 从上到下逐条判断，**先命中者生效，后面的全部跳过**。
#   因此：条件更"窄"的规则必须写在更"宽"的规则前面。
#
#   反例：如果把 `if command = "x"`（单按轻拳）写在
#         `if command = "QCF_x"`（波动拳，也以 x 结束）前面，
#         那么波动拳永远轮不到 —— 每次都会被单按规则抢走。
#
#   KFM 源码里也写着同一句话（kfm.cmd / command.zss 的注释）：
#   "State entry with a certain command must come before another
#    state entry with a command that is the subset of the first."
#
# 输出顺序约定（照抄，不要随意调换）：
#   超必杀 → 消耗气槽的必杀 → 普通必杀 → 防御 → 前冲/后跳 → 投技
#   → 站立普通技 → 嘲讽 → 下蹲普通技 → 空中普通技
#
# 依据：docs/ikemen_character_architecture.md §4.3 / §5.3
# 实测对照：game/chars/p1_kfm_zss_lab/command.zss
# ============================================================================


# ============================================================================
# 工具函数：连段条件
#
# $canCombo = 1 表示"现在可以接必杀技"。把重复的条件集中在这里，
# 避免每个招式各写一遍。
#
# 这是"函数跨状态复用"的样板：let 声明、if 判断、返回值。
# ============================================================================
[Function Combo() ret]
let ret = 0;
# 可以自由出招，或正处于可取消的普通技中且已命中，或刚从防御中出来
if (stateType != A && ctrl) ||
    ((stateNo = [200, 299] || stateNo = [400, 499]) && stateNo != 440 && moveContact) ||
    (stateNo = 1310 || stateNo = 1330) {
    let ret = 1;
}


# ============================================================================
# [StateDef -1] —— 特殊状态：无论当前在哪个状态，每 tick 都执行一次。
# 命令路由之所以能"随时生效"，就是因为它写在这里。
# ============================================================================
[StateDef -1]

# 只在战斗进行中处理命令（roundState = 2），且该角色由玩家操作（!aiLevelF）
if roundState = 2 && !aiLevelF {

    let canCombo = call Combo();
    ignoreHitPause{mapSet{map:"canCombo"; value: $canCombo}}

    # ========================================================================
    # 【① 超必杀】消耗 1 条气（1000）。P2 之后填充。
    # ========================================================================
    #if command = "Super_Example" && power >= 1000 && stateType != A && $canCombo {
    #    changeState{value: 3000}
    #}

    # ========================================================================
    # 【② 必杀技】窄条件的写在宽条件之前
    # 例：QCF_xy（EX 版，同时按两个键）必须写在 QCF_x / QCF_y 前面
    # ========================================================================
    #if command = "QCF_xy" && power >= 500 && $canCombo {
    #    changeState{value: 1020}
    #}
    #if command = "QCF_x" && $canCombo {
    #    changeState{value: 1000}
    #}
    #if command = "QCF_y" && $canCombo {
    #    changeState{value: 1010}
    #}

    # ========================================================================
    # 【③ 防御】
    # ========================================================================
    #if command = "blocking" && command != "holddown" &&
    #    (ctrl && stateType != A) {
    #    changeState{value: 1300}
    #}

    # ========================================================================
    # 【④ 双击方向：前冲 / 后跳】
    # ========================================================================
    if command = "FF" && stateType = S && ctrl {
        changeState{value: 100}
    }
    if command = "BB" && stateType = S && ctrl {
        changeState{value: 105}
    }

    # ========================================================================
    # 【⑤ 投技】要求贴身 + 对手站或蹲 + 对手不在受击硬直
    # 注意：投技用 y 键，所以它必须写在单按 y（重拳）之前，否则永远进不来
    # ========================================================================
    #if command = "y" && stateType = S && ctrl && stateNo != 100 &&
    #    (p2StateType = S || p2StateType = C) && p2MoveType != H &&
    #    ((command = "holdfwd" && p2BodyDist X < 3) ||
    #     (command = "holdback" && p2BodyDist X < 5)) {
    #    changeState{value: 800}
    #}

    # ========================================================================
    # 【⑥ 站立普通技】4 键核心
    # ========================================================================
    # 站立轻拳（LP）
    if command = "x" && command != "holddown" &&
        (stateType = S && ctrl) {
        changeState{value: 200}
    }

    # 站立重拳（HP）—— P2 实现 State 210 后启用
    #if command = "y" && command != "holddown" &&
    #    (stateType = S && ctrl) {
    #    changeState{value: 210}
    #}

    # 站立轻脚（LK）—— P2 实现 State 230 后启用
    #if command = "a" && command != "holddown" &&
    #    (stateType = S && ctrl) {
    #    changeState{value: 230}
    #}

    # 站立重脚（HK）—— P2 实现 State 240 后启用
    #if command = "b" && command != "holddown" &&
    #    (stateType = S && ctrl) {
    #    changeState{value: 240}
    #}

    # ========================================================================
    # 【⑦ 嘲讽】
    # ========================================================================
    if command = "start" && command != "holddown" && stateType != A && ctrl {
        changeState{value: 195}
    }

    # ========================================================================
    # 【⑧ 下蹲普通技】先判断 holddown，再判断按键
    # ========================================================================
    #if command = "x" && command = "holddown" && stateType = C && ctrl {
    #    changeState{value: 400}
    #}

    # ========================================================================
    # 【⑨ 空中普通技】
    # ========================================================================
    #if command = "x" && stateType = A && ctrl {
    #    changeState{value: 600}
    #}

# End of file: roundState = 2
# =============================================================================
}
