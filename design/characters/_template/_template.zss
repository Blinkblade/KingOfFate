# ============================================================================
# KingOfFate — Base Fighter Template : 主体状态脚本（ZSS）
#
# 这里放角色的"状态主体"：每个 [StateDef N] 是一个状态。
# 命令名 → 状态号的映射在 command.zss，不在本文件。
#
# 最小可跑集合（P2 起点）：
#   200  站立轻拳（LP）—— 唯一一个完整实现的攻击，作为复制样板
#   195  嘲讽           —— 非攻击状态样板（最简单的状态长什么样）
#
# 后续按编号段扩展（见 docs/ikemen_character_architecture.md §4.1）：
#   210/230/240  站立重拳/轻脚/重脚
#   400-440      下蹲普通技
#   600-640      空中普通技
#   800          投技
#   1000+        必杀技
#   3000+        超必杀
#
# 语法硬规则（架构文档 §5.2）：
#   * sctrl 的左花括号必须与控制器名同行：  hitDef{   ✅   hitDef   ❌
#   * [StateDef N; ...] 头部用分号分隔、] 收尾
#   * 触发器就是 if <表达式> { ... }，不用 trigger1 = 的旧写法
#   * 范围匹配：[a, b] 闭区间，[a, b) 半开区间
#
# 实测对照：game/chars/p1_kfm_zss_lab/kfm.zss（StateDef 195 / 200 / 210）
# ============================================================================


# ============================================================================
# 嘲讽（Taunt）—— 非攻击状态的最小样板
# 要点：有明确时长（time）、结束时把控制权还回去（ctrlSet + EndState）
# ============================================================================
[StateDef 195;
type: S; movetype: I; physics: S;
anim: 195; ctrl: 0;
velset: 0, 0;
sprpriority: 2;]

# 40 tick 后恢复可操作
if time = 40 {
    ctrlSet{value: 1}
}

# 状态结束 → 回到站立
call EndState(0);


# ============================================================================
# 站立轻拳（Stand Light Punch）—— 攻击状态的标准样板
#
# 这是 P2 之后"每加一个新招式就复制一份"的模板。它展示了攻击状态的
# 全部必备结构：
#   1) 状态头：type/movetype/physics/anim/ctrl/velset/poweradd/sprpriority
#   2) 在明确的 animElem 上触发 hitDef
#   3) 出招音效
#   4) EndState 收尾
# ============================================================================
# 难度：简单
[StateDef 200;
type: S;                              # S-站立 / C-下蹲 / A-空中 / L-倒地
movetype: A;                          # A-攻击 / I-待机 / H-受击
physics: S;                           # S-站立 / C-下蹲 / A-空中
juggle: 1;                            # 本招消耗的空中追打点数
velset: 0, 0;                         # 出招期间不移动
ctrl: 0;                              # 出招期间不可操作
anim: 200;                            # 播放动画 200（定义在 _template.air）
poweradd: 10;                         # 出招集气量
sprpriority: 2;]                      # 绘制层级：2 = 在对手前面

# 动画推进到第 3 个元素时产生攻击判定。
# 注意：这个时点由 _template.air 里 Action 200 的帧数决定 ——
#       想改"出招快慢"，改 .air 的帧数，不用改这里（P1 实验 E3）。
if animElem = 3 {
    hitDef{
        attr: S, NA;                  # 属性：S-站姿, NA-普通攻击
        damage: 23, 0;                # 伤害, 防御伤害  ← E2 验证：掉血精确等于此值
        animtype: Light;              # 受击动画类型：Light/Medium/Heavy/Back
        guardflag: MA;                # 可被防住的方式
        hitflag: MAF;                 # 可命中的目标状态
        priority: 3, Hit;             # 攻击优先级 0-7（默认 4）
        pausetime: 8, 8;              # 命中停顿：攻击方, 防守方
        sparkno: 0;                   # 命中火花动画号
        sparkxy: -10, -76;            # 火花偏移
        hitsound: 5, 0;               # 命中音效
        guardsound: 6, 0;             # 防御音效
        ground.type: High;            # 地面受击类型
        ground.slidetime: 5;          # 地面滑动时间
        ground.hittime: 11;           # 地面受击硬直
        ground.velocity: -4;          # 地面击退速度
        airguard.velocity: -1.9, -.8; # 空中防御击退
        air.type: High;               # 空中受击类型
        air.velocity: -1.4, -3;       # 空中击退
        air.hittime: 15;              # 空中受击硬直
    }
}

# 第 1 tick 播报出招音效
if time = 1 {
    call CSnd(0, 0, 1);
}

# 状态结束 → 回到站立
call EndState(0);


# ============================================================================
# 本文件内部工具函数
# 见 command.zss 里的 [Function Combo() ret]，那是跨文件递归使用的样板。
# 本文件内部用到的简单包装放这里。
# ============================================================================
